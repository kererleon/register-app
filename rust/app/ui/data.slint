// What the Rust side shows: the data as display-ready text, and the actions
// the pages can trigger.

export struct HomeworkItem {
    id: int,
    kind: string,
    urgent: bool,     // due today (today page)
    // "MORGEN · DEUTSCH" on the today page, "DEUTSCH" in the list.
    header: string,
    title: string,
    subtitle: string,
    is-test: bool,
    is-grade: bool,
    checkable: bool,
    checked: bool,
    deletable: bool,
    type-icon: int,   // 0 assignment, 1 test, 2 grade, 3 observation, 4 test group, 5 reminder
    accent: int,      // 0 none, 1 red (test), 2 green (grade or done)
    badge: string,    // "neu", "geändert"
    moved-to: string, // "Fr. 13.11."
    day-date: string, // the entry's day, to find it again
    index: int,       // its place on that day
}

export struct HomeworkDay {
    date: string,     // "13.11.2026", for new reminders
    header: string,   // "FR. · 13.11.2026"
    title: string,    // "Morgen", "Samstag, 14.11."
    is-today: bool,
    items: [HomeworkItem],
}

export struct GradeItem {
    value: string,
    title: string,
    detail: string,
    date: string,
    weight: string,
    cancelled: bool,
}

export struct SubjectItem {
    id: int,
    name: string,
    average: string,
    average-value: float,
    color: color,
    test-chip: string,  // "Test Fr. 27.11."
    forecast: string,
    grades: [GradeItem],
}

export struct ChartLine {
    color: color,
    // SVG path commands in a 1000 × 100 box (grade 10 at the top).
    commands: string,
    dots: string,
}

export struct Lesson {
    hours: string,      // "1-2", "3."
    time: string,       // "07:50-09:30"
    subject: string,
    nick: string,       // "Deu"
    teachers: string,   // last names, one per line
    teacher-width: int, // characters of the longest name
    rooms: string,
    note: string,
    color: color,
    span: int,          // lessons it lasts
    first: int,         // first hour
    index: int,         // position in its day
    pattern: image,     // subject icons behind the tile
    photo: image,       // brainrot: the teacher's picture behind the tile
    has-photo: bool,
    selected: bool,
    has-test: bool,
    is-now: bool,
    is-past: bool,
}

// A teacher in the detail card: photo or initial.
export struct TeacherView {
    name: string,
    initial: string,
    photo: image,
    has-photo: bool,
    custom: bool,
}

// One line of the detail card (_ContentItem).
export struct DetailRow {
    icon: int,          // 0 time, 1 person, 2 people, 3 room, 4 lesson content, 5 test, 6 homework
    title: string,
    content: string,
}

export struct DetailCard {
    subject: string,
    letter: string,
    color: color,
    hours: string,
    times: string,
    teachers: [TeacherView],
    rows: [DetailRow],
    selected: bool,
}

export struct WeekDay {
    weekday: string,    // "MO"
    date: string,       // "09.11"
    is-today: bool,
    lessons: [Lesson],
}

export struct AbsenceItem {
    index: int,
    title: string,
    subtitle: string,
    reason: string,
    footer: string,
    status: string,
    level: int, // 0 justified, 1 open, 2 not justified, 3 for school
}

export struct MessageItem {
    id: int,
    subject: string,
    from: string,
    date: string,
    text: string,
    unread: bool,
}

// "Ø6 → 7½" under a test (TestTargets).
export struct TargetChip {
    target: int,
    kind: int,         // 0 safe, 1 impossible, 2 reachable
    needed: string,    // "7½"
    needed-value: float,
}

export struct TestItem {
    index: int,
    days: int,
    header: string,    // "FR. 13.11. · ENGLISCH"
    title: string,
    subtitle: string,
    average-now: string, // "7½", empty without grades
    targets: [TargetChip],
    date-long: string, // "Freitag, 13. November", for the study plan
}

export struct WeakSubject {
    name: string,
    value: float,
    label: string,
}

export struct SchoolItem {
    name: string,
    url: string,
}

export global AppData {
    // --- login ---
    in-out property <bool> logged-in: false;
    in-out property <bool> busy: false;
    in-out property <string> error;
    in-out property <string> status;
    in-out property <[SchoolItem]> schools;
    in-out property <bool> two-factor: false;
    callback search-schools(string);
    callback login(string /* url */, string /* user */, string /* password */, bool /* remember */);
    callback submit-two-factor(string);
    callback logout();
    callback refresh();

    // --- user ---
    in-out property <string> full-name;
    in-out property <string> school;
    in-out property <string> fetched;

    // --- today ---
    in-out property <string> now-header;
    // 0 loading, 1 no lessons, 2 running, 3 next lesson, 4 school is over
    in-out property <int> now-state;
    in-out property <string> now-subject;
    in-out property <int> now-minutes;
    in-out property <string> now-rooms;
    in-out property <string> next-time;
    in-out property <[Lesson]> today-lessons;
    in-out property <[HomeworkItem]> due;
    in-out property <[TestItem]> tests;
    in-out property <[WeakSubject]> weak;
    // Days since 2026, for the meme of the day.
    in-out property <int> day-number;
    // Study plan: the test, then the days it would use.
    pure callback study-days(int /* test */, int /* sessions */) -> [string];
    callback create-study-plan(int /* test */, int /* sessions */);

    // --- homework ---
    in-out property <[HomeworkDay]> homework;
    in-out property <bool> show-past: false;
    in-out property <string> tomorrow-date;
    callback toggle-done(int /* id */, string /* kind */, bool);
    callback set-show-past(bool);
    callback add-reminder(string /* date */, string /* text */);
    callback delete-reminder(int);
    callback move-homework(string /* day */, int /* index */, int /* year */, int /* month */, int /* day */);
    callback reset-move(string /* day */, int /* index */);
    callback homework-info(string /* day */, int /* index */);
    callback page-shown(int);
    in-out property <string> info-title;
    in-out property <string> info-text;

    // --- grades ---
    in-out property <[SubjectItem]> subjects;
    in-out property <string> overall;
    in-out property <float> overall-value;
    in-out property <string> overall-note;
    in-out property <[ChartLine]> chart;
    in-out property <string> chart-from;
    in-out property <string> chart-to;
    in-out property <int> semester: 0; // 0 first, 1 second, 2 both
    in-out property <bool> show-cancelled: false;
    in-out property <bool> sort-by-type: false;
    callback set-sort-by-type(bool);
    callback set-semester(int);
    callback set-show-cancelled(bool);
    callback open-subject(int);

    // --- calendar ---
    in-out property <[WeekDay]> week;
    in-out property <string> week-title;
    in-out property <int> week-hours: 8;
    callback move-week(int);
    in-out property <bool> detail-open: false;
    in-out property <string> detail-title;   // "Do., 12. Nov."
    in-out property <[DetailCard]> detail-cards;
    in-out property <int> detail-selected: -1;
    callback select-lesson(int /* day of week */, int /* lesson */);
    callback detail-move(int /* days */);
    callback close-detail();
    callback pick-teacher-image(int /* card */, int /* teacher */);
    callback reset-teacher-image(int /* card */, int /* teacher */);

    // --- absences ---
    in-out property <string> absence-percent;
    in-out property <float> absence-fraction;
    in-out property <int> absence-level;
    in-out property <string> absence-label;
    in-out property <string> absence-left;
    in-out property <int> year-left;
    in-out property <string> year-allowed;
    in-out property <string> year-allowed-rest;
    in-out property <string> year-detail;
    in-out property <string> count-absences;
    in-out property <string> count-justified;
    in-out property <string> count-not-justified;
    in-out property <string> count-delayed;
    in-out property <[AbsenceItem]> absences;
    in-out property <[AbsenceItem]> future-absences;
    in-out property <bool> absence-can-edit: false;
    callback report-absence(string /* from */, string /* to */, int /* first hour */, int /* last hour */, string /* reason */, string /* signature */);
    callback remove-future-absence(int);

    // --- messages ---
    in-out property <[MessageItem]> messages;
    in-out property <[MessageItem]> notifications;
    in-out property <int> unread;
    callback mark-read(int);
}

// The page shown (0 Heute, 1 Hausaufgaben, 2 Noten, 3 Absenzen, 4 Kalender,
// 5 Mitteilungen, 6 Einstellungen), as in the Flutter app's menu.
export global Nav {
    in-out property <int> page: 0;
    in-out property <bool> absence-form: false;
    in-out property <int> study-plan: -1; // the test whose plan is open
    in-out property <bool> info: false;
}

// Decorations of the brainrot and israel backgrounds: emojis, stars and
// stickers, placed by Rust like the Flutter app's painter.
export struct DecoItem {
    kind: int,        // 0 emoji, 1 star, 2 sticker
    text: string,
    x: length,
    y: length,
    size: length,     // font size or star radius
    rotation: angle,
    opacity: float,
    path: string,     // star outline, in a box of 2 × size
}

export global Deco {
    in-out property <string> stripes;   // brainrot: diagonal stripes
    in-out property <[DecoItem]> items;
    in-out property <length> flag-height; // israel: the flag at the top
    in-out property <string> flag-star;
    callback resized(length, length);
}
