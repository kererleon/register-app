import { Theme } from "theme.slint";
import { AppData, Nav, Prefs } from "data.slint";
import { GlowCard, Field, PrimaryButton, TextButton, HudLabel } from "widgets.slint";
import { CheckBox } from "std-widgets.slint";

export component LoginPage inherits Rectangle {
    property <string> school-name;
    property <string> school-url;
    property <bool> remember: true;

    VerticalLayout {
        alignment: center;
        padding: Theme.page-padding;
        HorizontalLayout {
            alignment: center;
            GlowCard {
                width: min(440px, root.width - 2 * Theme.page-padding);
                VerticalLayout {
                    spacing: 12px;
                    Text {
                        text: "Register";
                        color: Theme.accent-gradient;
                        font-family: Theme.font-display;
                        font-size: 32px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    if !AppData.two-factor: VerticalLayout {
                        spacing: 10px;
                        HudLabel { text: "SCHULE"; }
                        if root.school-url == "": VerticalLayout {
                            spacing: 6px;
                            Field {
                                placeholder: "Schule suchen, z. B. Fallmerayer";
                                edited(t) => { AppData.search-schools(t); }
                            }
                            Rectangle {
                                height: min(220px, AppData.schools.length * 40px);
                                visible: AppData.schools.length > 0;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.outline;
                                clip: true;
                                Flickable {
                                    content-height: AppData.schools.length * 40px;
                                    for school[i] in AppData.schools: Rectangle {
                                        y: i * 40px;
                                        height: 40px;
                                        background: ta.has-hover ? Theme.surface-high : transparent;
                                        Text {
                                            x: 12px;
                                            width: parent.width - 24px;
                                            text: school.name;
                                            color: Theme.text;
                                            font-family: Theme.font-body;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.school-name = school.name;
                                                root.school-url = school.url;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if root.school-url != "": HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.school-name;
                                color: Theme.text;
                                font-family: Theme.font-body;
                                font-size: 14px;
                                font-weight: 600;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                            TextButton {
                                text: "Ändern";
                                clicked => {
                                    root.school-url = "";
                                    root.school-name = "";
                                }
                            }
                        }
                        HudLabel { text: "ANMELDUNG"; }
                        user := Field { placeholder: "Benutzername"; }
                        pass := Field {
                            placeholder: "Passwort";
                            password: true;
                            accepted => {
                                AppData.login(root.school-url, user.text, pass.text, root.remember);
                            }
                        }
                        HorizontalLayout {
                            CheckBox {
                                text: "Angemeldet bleiben";
                                checked <=> root.remember;
                            }
                            Rectangle { }
                            if root.school-url != "": Rectangle {
                                width: forgot.preferred-width + 32px;
                                height: 34px;
                                border-radius: 8px;
                                background: forgot-ta.has-hover ? #9e9e9e22 : transparent;
                                forgot := Text {
                                    text: "Passwort vergessen";
                                    color: #9e9e9e;
                                    font-family: Theme.font-body;
                                    font-size: 14px;
                                    font-weight: 500;
                                }
                                forgot-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        Prefs.reset-url = root.school-url;
                                        Prefs.profile-message = "";
                                        Nav.profile = 4;
                                    }
                                }
                            }
                        }
                        if AppData.error != "": Text {
                            text: AppData.error;
                            color: Theme.danger;
                            font-family: Theme.font-body;
                            font-size: 14px;
                            wrap: word-wrap;
                        }
                        PrimaryButton {
                            text: "Anmelden";
                            busy: AppData.busy;
                            enabled: root.school-url != "" && user.text != "" && pass.text != "";
                            clicked => {
                                AppData.login(root.school-url, user.text, pass.text, root.remember);
                            }
                        }
                        HorizontalLayout {
                            alignment: center;
                            TextButton {
                                text: "Ohne Konto ausprobieren (Demo)";
                                clicked => {
                                    AppData.login("https://vinzentinum.digitalesregister.it", "demo-user-6540", "demo", false);
                                }
                            }
                        }
                    }
                    if AppData.two-factor: VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: "Zweiter Faktor wird benötigt";
                            color: Theme.text;
                            font-family: Theme.font-display;
                            font-size: 18px;
                            font-weight: 600;
                        }
                        tfa := Field {
                            placeholder: "Code";
                            accepted => { AppData.submit-two-factor(tfa.text); }
                        }
                        if AppData.error != "": Text {
                            text: AppData.error;
                            color: Theme.danger;
                            wrap: word-wrap;
                        }
                        PrimaryButton {
                            text: "Bestätigen";
                            busy: AppData.busy;
                            clicked => { AppData.submit-two-factor(tfa.text); }
                        }
                    }
                }
            }
        }
    }
}
