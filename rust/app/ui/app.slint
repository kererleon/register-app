import { Theme } from "theme.slint";
import { AppData, Nav, Deco, DecoItem, Competence, GradeGroup, ForecastResult, CalcGrade, DetailCard, DetailRow, TeacherView, TestItem, TargetChip, WeakSubject, HomeworkItem, HomeworkDay, GradeItem, SubjectItem, ChartLine, Lesson, WeekDay, AbsenceItem, MessageItem, SchoolItem } from "data.slint";
import { Backdrop, PrimaryButton } from "widgets.slint";
import { LoginPage } from "login.slint";
import { TodayPage, HomeworkPage, StudyPlanDialog, InfoDialog } from "pages.slint";
import { GradesPage, ChartPage, CalculatorPage } from "grades.slint";
import { CalendarPage, AbsencesPage, AbsenceForm, MessagesPage, SettingsPage, CertificatePage } from "pages2.slint";

export { Theme, AppData, Nav, Deco, DecoItem, Competence, GradeGroup, ForecastResult, CalcGrade, DetailCard, DetailRow, TeacherView, TestItem, TargetChip, WeakSubject, HomeworkItem, HomeworkDay, GradeItem, SubjectItem, ChartLine, Lesson, WeekDay, AbsenceItem, MessageItem, SchoolItem }

struct NavEntry {
    icon: image,
    label: string,
    page: int,
}

// A menu entry like the Flutter drawer's ListTile.
component DrawerItem inherits Rectangle {
    in property <NavEntry> entry;
    in property <bool> selected;
    in property <bool> collapsed;
    in property <int> badge;
    callback clicked();
    height: 48px;
    border-radius: 12px;
    background: selected ? Theme.primary.transparentize(84%) : (ta.has-hover ? Theme.text.transparentize(94%) : transparent);
    HorizontalLayout {
        padding-left: collapsed ? 0px : 12px;
        padding-right: 12px;
        spacing: 16px;
        alignment: collapsed ? center : start;
        Image {
            source: entry.icon;
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            colorize: selected ? Theme.violet : Theme.text;
        }
        if !collapsed: Text {
            text: entry.label;
            color: selected ? Theme.violet : Theme.text;
            font-family: Theme.font-body;
            font-size: 15px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if !collapsed && badge > 0: Rectangle {
            width: 22px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: Theme.danger;
            Text {
                text: badge;
                color: white;
                font-family: Theme.font-body;
                font-size: 11px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.outline;
}

component BottomItem inherits Rectangle {
    in property <NavEntry> entry;
    in property <bool> selected;
    callback clicked();
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 30px;
                border-radius: 15px;
                background: root.selected ? Theme.selected-bg : transparent;
                Image {
                    source: root.entry.icon;
                    width: 22px;
                    height: 22px;
                    colorize: root.selected ? Theme.violet : Theme.text;
                }
            }
        }
        Text {
            text: root.entry.label;
            color: root.selected ? Theme.violet : Theme.muted;
            font-family: Theme.font-body;
            font-size: 11px;
            font-weight: root.selected ? 600 : 500;
            horizontal-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "Register";
    icon: @image-url("../icon.png");
    preferred-width: 1240px;
    preferred-height: 820px;
    min-width: 340px;
    min-height: 480px;
    background: Theme.bg;
    default-font-family: Theme.font-body;
    default-font-size: 14px;
    // Kept for starting on a given page (REGISTER_PAGE).
    in-out property <int> page <=> Nav.page;
    property <bool> collapsed: false;
    property <[string]> titles: [
        Theme.br("Heute", "Heute, no cap 💀", "Shalom achi! 🇮🇱"),
        Theme.br("Register", "Register 🧠🔥", "Register 🇮🇱 Yalla"),
        "Noten", "Absenzen", "Kalender", "Mitteilungen", "Einstellungen", "Zeugnis", "Notenrechner"];
    property <[NavEntry]> nav: [
        { icon: @image-url("icons/bolt.svg"), label: Theme.br("Heute", "Heute 🗿", "Heute 🇮🇱 Yalla"), page: 0 },
        { icon: @image-url("icons/assignment.svg"), label: Theme.br("Hausaufgaben", "Hausaufgaben 😭", "Hausaufgaben 😩 Balagan"), page: 1 },
        { icon: @image-url("icons/star.svg"), label: Theme.br("Noten", "Noten 📉", "Noten 📈 Tachles"), page: 2 },
        { icon: @image-url("icons/hotel.svg"), label: Theme.br("Absenzen", "Absenzen 🛌", "Absenzen 🏖️ Matkot-Pause"), page: 3 },
        { icon: @image-url("icons/calendar_today.svg"), label: Theme.br("Kalender", "Kalender 🗓️", "Kalender 🗓️ Ma nishma"), page: 4 },
        { icon: @image-url("icons/list.svg"), label: Theme.br("Zeugnis", "Zeugnis 📜", "Zeugnis 📜 Kapara"), page: 7 },
        { icon: @image-url("icons/chat.svg"), label: Theme.br("Mitteilungen", "Mitteilungen 📨", "Mitteilungen 📨 Achi?"), page: 5 },
    ];
    property <NavEntry> settings-entry: { icon: @image-url("icons/settings.svg"), label: Theme.br("Einstellungen", "Einstellungen ⚙️", "Einstellungen ⚙️ Beseder"), page: 6 };
    property <NavEntry> logout-entry: { icon: @image-url("icons/logout.svg"), label: Theme.br("Abmelden", "Abmelden ✌️", "Yalla bye ✌️🇮🇱"), page: -1 };
    // Phones: four pages below and "Mehr" for the rest.
    property <[NavEntry]> bottom: [
        { icon: @image-url("icons/bolt.svg"), label: "Heute", page: 0 },
        { icon: @image-url("icons/assignment.svg"), label: "Aufgaben", page: 1 },
        { icon: @image-url("icons/star.svg"), label: "Noten", page: 2 },
        { icon: @image-url("icons/calendar_today.svg"), label: "Kalender", page: 4 },
        { icon: @image-url("icons/list.svg"), label: "Mehr", page: -2 },
    ];
    property <bool> narrow: self.width < 720px;
    changed page => { AppData.page-shown(self.page); }
    changed narrow => { Theme.narrow = self.narrow; }
    init => { Theme.narrow = self.narrow; }

    Backdrop {
        width: 100%;
        height: 100%;
    }

    if !AppData.logged-in: LoginPage {
        width: 100%;
        height: 100%;
    }

    if AppData.logged-in: HorizontalLayout {
        // The menu (Flutter's drawer).
        if !root.narrow: Rectangle {
            width: root.collapsed ? 72px : 264px;
            background: Theme.dark ? Theme.night.darker(40%) : Theme.bg;
            animate width { duration: 160ms; easing: ease-out; }
            Rectangle {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                border-radius: 12px;
                background: Theme.drawer;
                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    // The account.
                    Rectangle {
                        height: 56px;
                        HorizontalLayout {
                            padding-left: root.collapsed ? 0px : 12px;
                            padding-right: 12px;
                            spacing: 16px;
                            alignment: root.collapsed ? center : start;
                            Image {
                                source: @image-url("icons/account_circle.svg");
                                width: 24px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                colorize: Theme.text;
                            }
                            if !root.collapsed: Text {
                                text: AppData.full-name;
                                color: Theme.text;
                                font-family: Theme.font-body;
                                font-size: 15.5px;
                                font-weight: 500;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if !root.collapsed: Image {
                                source: @image-url("icons/arrow_drop_down.svg");
                                width: 24px;
                                height: 24px;
                                y: (parent.height - self.height) / 2;
                                colorize: Theme.text;
                            }
                        }
                    }
                    Rectangle { }
                    for entry in root.nav: DrawerItem {
                        entry: entry;
                        collapsed: root.collapsed;
                        selected: Nav.page == entry.page;
                        badge: entry.page == 5 ? AppData.unread : 0;
                        clicked => { Nav.page = entry.page; }
                    }
                    Divider { }
                    DrawerItem {
                        entry: root.settings-entry;
                        collapsed: root.collapsed;
                        selected: Nav.page == 6;
                        clicked => { Nav.page = 6; }
                    }
                    Divider { }
                    DrawerItem {
                        entry: root.logout-entry;
                        collapsed: root.collapsed;
                        clicked => { AppData.logout(); }
                    }
                    Divider { }
                    DrawerItem {
                        entry: { icon: root.collapsed ? @image-url("icons/chevron_right.svg") : @image-url("icons/chevron_left.svg"), label: "", page: -3 };
                        collapsed: true;
                        clicked => { root.collapsed = !root.collapsed; }
                    }
                }
            }
        }

        VerticalLayout {
            // The app bar with the page's title.
            Rectangle {
                height: root.narrow ? 52px : 56px;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    if Nav.page == 8: Image {
                        y: (parent.height - self.height) / 2;
                        width: 24px;
                        height: 24px;
                        source: @image-url("icons/arrow_back.svg");
                        colorize: Theme.text;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Nav.page = 2; }
                        }
                    }
                    if Nav.page == 8: Rectangle { width: 16px; }
                    Text {
                        text: root.titles[Nav.page];
                        color: Theme.text;
                        font-family: Theme.font-display;
                        font-size: 19px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Rectangle { }
                    if Nav.page == 2: Rectangle {
                        width: sem.preferred-width + 30px;
                        sem := Text {
                            x: 0;
                            text: AppData.semester == 0 ? "1. Semester" : (AppData.semester == 1 ? "2. Semester" : "Ganzes Jahr");
                            color: Theme.text;
                            font-family: Theme.font-body;
                            font-size: 15px;
                            vertical-alignment: center;
                            height: parent.height;
                        }
                        Image {
                            x: parent.width - 24px;
                            width: 24px;
                            height: 24px;
                            source: @image-url("icons/arrow_drop_down.svg");
                            colorize: Theme.text;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppData.set-semester(Math.mod(AppData.semester + 1, 3)); }
                        }
                    }
                    if AppData.status != "" && !root.narrow: Text {
                        text: AppData.status;
                        color: Theme.muted;
                        font-family: Theme.font-mono;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.outline;
                }
            }
            Rectangle {
                if Nav.page == 0: TodayPage { }
                if Nav.page == 1: HomeworkPage { }
                if Nav.page == 2: GradesPage { }
                if Nav.page == 3: AbsencesPage { }
                if Nav.page == 4: CalendarPage { }
                if Nav.page == 5: MessagesPage { }
                if Nav.page == 6: SettingsPage { }
                if Nav.page == 7: CertificatePage { }
                // LastFetchedOverlay: offline with saved data.
                if Nav.page == 7 && AppData.certificate-fetched != "": Rectangle {
                    x: parent.width - self.width;
                    y: parent.height - self.height;
                    width: offline-text.preferred-width + 16px;
                    height: offline-text.preferred-height + 6px;
                    background: #0000008c;
                    border-radius: 5px;
                    offline-text := Text {
                        text: AppData.certificate-fetched;
                        color: white;
                        font-size: 14px;
                    }
                }
                if Nav.page == 8: CalculatorPage { }
                if Nav.page == 3 && AppData.absence-can-edit: PrimaryButton {
                    x: parent.width - self.width - 16px;
                    y: parent.height - self.height - 16px;
                    width: 210px;
                    height: 52px;
                    text: "Abwesenheit melden";
                    icon: @image-url("icons/add.svg");
                    has-icon: true;
                    clicked => { Nav.absence-form = true; }
                }
                if root.narrow && AppData.status != "": Rectangle {
                    y: 6px;
                    x: (parent.width - self.width) / 2;
                    width: min(parent.width - 24px, status-text.preferred-width + 24px);
                    height: 28px;
                    border-radius: 14px;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.outline;
                    status-text := Text {
                        text: AppData.status;
                        color: Theme.muted;
                        font-family: Theme.font-body;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            if root.narrow: Rectangle {
                height: 68px;
                background: Theme.drawer;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.outline;
                }
                HorizontalLayout {
                    padding: 4px;
                    for entry in root.bottom: BottomItem {
                        entry: entry;
                        selected: entry.page == -2 ? (Nav.page == 3 || Nav.page >= 5) : Nav.page == entry.page;
                        clicked => {
                            if entry.page >= 0 {
                                Nav.page = entry.page;
                            } else {
                                // "Mehr": absences, messages, settings in turn.
                                Nav.page = Nav.page == 3 ? 5 : (Nav.page == 5 ? 6 : 3);
                            }
                        }
                    }
                }
            }
        }
    }

    if Nav.study-plan >= 0 && Nav.study-plan < AppData.tests.length: StudyPlanDialog {
        width: 100%;
        height: 100%;
        test: AppData.tests[Nav.study-plan];
    }

    if Nav.chart: ChartPage {
        width: 100%;
        height: 100%;
    }

    if Nav.info: InfoDialog {
        width: 100%;
        height: 100%;
    }

    if Nav.absence-form: AbsenceForm {
        width: 100%;
        height: 100%;
    }
}
