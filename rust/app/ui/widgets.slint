import { Theme } from "theme.slint";
import { Deco } from "data.slint";

// The page background of each look (AuroraBackdrop / _AuroraPainter):
// holo glow and grid, brainrot stripes and emojis, the israel flag with
// stars, emojis and stickers, glass light spots, clean nothing.
export component Backdrop inherits Rectangle {
    background: Theme.bg;
    clip: true;
    property <length> shortest: min(self.width, self.height);
    // Recomputed for a new size, look or brightness.
    property <int> style-watch: Theme.style;
    property <bool> dark-watch: Theme.dark;
    changed style-watch => { Deco.resized(self.width, self.height); }
    changed dark-watch => { Deco.resized(self.width, self.height); }
    changed width => { Deco.resized(self.width, self.height); }
    changed height => { Deco.resized(self.width, self.height); }
    init => { Deco.resized(self.width, self.height); }

    // Holo
    if Theme.holo: Rectangle {
        x: root.width * 0.05 - root.shortest * 0.95;
        y: root.height * 0.02 - root.shortest * 0.95;
        width: root.shortest * 1.9;
        height: self.width;
        background: @radial-gradient(circle, Theme.violet.transparentize(Theme.dark ? 70% : 84%) 0%, Theme.violet.transparentize(100%) 70%);
    }
    if Theme.holo: Rectangle {
        x: root.width - root.shortest * 0.9;
        y: root.height * 0.85 - root.shortest * 0.9;
        width: root.shortest * 1.8;
        height: self.width;
        background: @radial-gradient(circle, Theme.cyan.transparentize(Theme.dark ? 84% : 88%) 0%, Theme.cyan.transparentize(100%) 70%);
    }
    if Theme.holo: Image {
        width: 100%;
        height: 100%;
        source: @image-url("grid.svg");
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
        colorize: Theme.dark ? #ffffff : Theme.ink;
        opacity: Theme.dark ? 1 : 1.15;
    }

    // Glass: four soft light spots.
    if Theme.glass: Rectangle {
        x: root.width * 0.1 - root.shortest * 0.9;
        y: root.height * 0.08 - root.shortest * 0.9;
        width: root.shortest * 1.8;
        height: self.width;
        background: @radial-gradient(circle, (Theme.dark ? #0A84FF8c : #0A84FF73) 0%, #0A84FF00 70%);
    }
    if Theme.glass: Rectangle {
        x: root.width * 0.95 - root.shortest * 0.75;
        y: root.height * 0.3 - root.shortest * 0.75;
        width: root.shortest * 1.5;
        height: self.width;
        background: @radial-gradient(circle, (Theme.dark ? #BF5AF270 : #BF5AF25c) 0%, #BF5AF200 70%);
    }
    if Theme.glass: Rectangle {
        x: root.width * 0.2 - root.shortest * 0.8;
        y: root.height * 0.75 - root.shortest * 0.8;
        width: root.shortest * 1.6;
        height: self.width;
        background: @radial-gradient(circle, (Theme.dark ? #64D2FF62 : #64D2FF50) 0%, #64D2FF00 70%);
    }
    if Theme.glass: Rectangle {
        x: root.width * 0.85 - root.shortest * 0.7;
        y: root.height * 0.95 - root.shortest * 0.7;
        width: root.shortest * 1.4;
        height: self.width;
        background: @radial-gradient(circle, (Theme.dark ? #FF64824e : #FF648240) 0%, #FF648200 70%);
    }

    // Brainrot: diagonal stripes.
    if Theme.brainrot: Path {
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: Theme.violet.transparentize(Theme.dark ? 93% : 88%);
        stroke-width: 18px;
        commands: Deco.stripes;
    }

    // Israel: the flag across the top, a fade into the page, the bottom stripe.
    if Theme.israel: Rectangle {
        y: 0;
        height: Deco.flag-height;
        background: #ffffff;
        Rectangle {
            y: parent.height * 0.1;
            height: parent.height * 0.15;
            background: #0038B8;
        }
        Rectangle {
            y: parent.height * 0.75;
            height: parent.height * 0.15;
            background: #0038B8;
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: root.width / 1px;
            viewbox-height: Deco.flag-height / 1px;
            stroke: #0038B8;
            stroke-width: Deco.flag-height * 0.035;
            commands: Deco.flag-star;
        }
    }
    if Theme.israel: Rectangle {
        y: Deco.flag-height - 40px;
        height: 60px;
        background: @linear-gradient(180deg, Theme.night.transparentize(100%) 0%, Theme.bg 100%);
    }
    if Theme.israel: Rectangle {
        y: root.height - 14px;
        height: 8px;
        background: Theme.violet-deep.transparentize(Theme.dark ? 30% : 10%);
    }

    // Emojis, stars and stickers (brainrot and israel).
    if Theme.sticker: Rectangle {
        for item in Deco.items: Rectangle {
            x: item.x;
            y: item.y;
            width: item.kind == 1 ? item.size * 2 : (item.kind == 2 ? sticker-text.preferred-width + 20px : emoji.preferred-width);
            height: item.kind == 1 ? item.size * 2 : (item.kind == 2 ? sticker-text.preferred-height + 12px : emoji.preferred-height);
            transform-rotation: item.rotation;
            transform-origin: { x: 0, y: 0 };
            if item.kind == 1: Path {
                width: 100%;
                height: 100%;
                viewbox-width: item.size * 2 / 1px;
                viewbox-height: item.size * 2 / 1px;
                stroke: Theme.violet-deep.transparentize(100% - item.opacity * 100%);
                stroke-width: 1.8px;
                commands: item.path;
            }
            emoji := Text {
                visible: item.kind == 0;
                x: 0;
                y: 0;
                text: item.kind == 0 ? item.text : "";
                font-size: item.size;
                opacity: item.opacity;
            }
            if item.kind == 2: Rectangle {
                x: 3px;
                y: 3px;
                border-radius: 8px;
                background: Theme.violet-deep.transparentize(Theme.dark ? 75% : 82%);
            }
            if item.kind == 2: Rectangle {
                border-radius: 8px;
                background: #ffffff.transparentize(Theme.dark ? 90% : 30%);
                border-width: 1.5px;
                border-color: Theme.violet-deep.transparentize(Theme.dark ? 55% : 60%);
            }
            sticker-text := Text {
                visible: item.kind == 2;
                x: 10px;
                y: 6px;
                text: item.kind == 2 ? item.text : "";
                font-family: "Rubik";
                font-weight: 900;
                font-size: item.size;
                letter-spacing: 0.5px;
                color: Theme.violet-deep.transparentize(Theme.dark ? 45% : 50%);
            }
        }
    }
}

// Small upper-case caption (HudLabel): monospace in holo, Bangers in
// brainrot, Rubik in israel. The text must be given in capitals.
export component HudLabel inherits Text {
    color: Theme.muted;
    font-family: Theme.font-mono;
    font-size: Theme.brainrot ? 12px : 10.5px;
    font-weight: Theme.israel ? 700 : 600;
    letter-spacing: Theme.brainrot ? 1.1px : (Theme.israel ? 0.4px : 1.6px);
}

// "● FÄLLIG" above a group of panels.
export component SectionLabel inherits HorizontalLayout {
    in property <string> text;
    spacing: 8px;
    padding-top: 14px;
    padding-bottom: 2px;
    padding-left: 4px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 5px;
            height: 5px;
            border-radius: 2.5px;
            background: Theme.violet;
        }
    }
    HudLabel {
        text: root.text;
        vertical-alignment: center;
    }
}

// The large card (GlowCard): holo with a gradient frame and glow, sticker
// looks with a thick frame and a hard shadow, clean flat, glass translucent.
export component GlowCard inherits Rectangle {
    border-radius: Theme.radius-card;
    background: Theme.holo ? Theme.accent-gradient : (Theme.sticker ? Theme.accent-gradient : (Theme.glass ? Theme.glass-fill-strong : Theme.surface));
    border-width: Theme.clean ? 1px : (Theme.glass ? 1px : 0px);
    border-color: Theme.glass ? Theme.glass-border : Theme.outline;
    drop-shadow-blur: Theme.holo ? 28px : 0px;
    drop-shadow-offset-x: Theme.sticker ? 7px : 0px;
    drop-shadow-offset-y: Theme.sticker ? 7px : 0px;
    drop-shadow-color: Theme.holo ? Theme.violet.transparentize(Theme.dark ? 72% : 86%) : (Theme.sticker ? (Theme.dark ? Theme.cyan : Theme.ink) : transparent);
    if Theme.holo || Theme.sticker: Rectangle {
        x: Theme.sticker ? 3px : 1.2px;
        y: self.x;
        width: parent.width - 2 * self.x;
        height: parent.height - 2 * self.y;
        border-radius: Theme.sticker ? 9px : Theme.radius-card - 1.2px;
        background: Theme.sticker ? (Theme.dark ? Theme.night-surface : #ffffff) : Theme.surface;
    }
    VerticalLayout {
        padding: Theme.sticker ? 23px : 20px;
        @children
    }
}

component Bracket inherits Path {
    width: 30px;
    height: 30px;
    stroke-width: 1.6px;
    fill: transparent;
    viewbox-width: 30;
    viewbox-height: 30;
}

// A panel (HoloPanel): holo glass with glowing corner brackets, sticker
// looks with a thick frame and hard shadow, clean flat, glass translucent.
// [accent] draws a coloured stripe on the left (not in the clean look).
export component HoloPanel inherits Rectangle {
    in property <bool> clickable: false;
    in property <bool> highlighted: false;
    in property <color> accent: transparent;
    in property <bool> has-accent: false;
    in property <length> inner-padding: 14px;
    callback clicked();
    property <color> bracket-color: (highlighted ? Theme.secondary : Theme.primary).transparentize(highlighted ? 0% : 25%);
    property <color> edge: highlighted ? Theme.cyan : (has-accent ? accent : Theme.violet);
    border-radius: Theme.radius-panel;
    background: Theme.sticker ? (Theme.dark ? Theme.night-surface : #ffffff)
        : (Theme.glass ? Theme.glass-fill
        : (Theme.clean ? Theme.surface
        : (touch.has-hover && clickable ? Theme.surface-high.transparentize(20%) : Theme.surface.transparentize(Theme.dark ? 32% : 15%))));
    border-width: Theme.sticker ? 2.5px : (Theme.clean && highlighted ? 1.5px : 1px);
    border-color: Theme.sticker ? (Theme.dark ? root.edge : Theme.ink)
        : (Theme.glass ? (highlighted ? Theme.violet.transparentize(30%) : Theme.glass-border)
        : (Theme.clean ? (highlighted ? Theme.violet : Theme.outline)
        : (highlighted ? Theme.secondary.transparentize(40%) : Theme.outline)));
    drop-shadow-offset-x: Theme.sticker ? 5px : 0px;
    drop-shadow-offset-y: Theme.sticker ? 5px : 0px;
    drop-shadow-blur: 0px;
    drop-shadow-color: Theme.sticker ? (Theme.dark ? root.edge.transparentize(15%) : Theme.ink) : transparent;
    touch := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }
    if root.has-accent && (Theme.holo || Theme.glass): Rectangle {
        x: 0;
        y: Theme.glass ? 14px : 10px;
        width: Theme.glass ? 4px : 3.5px;
        height: parent.height - 2 * self.y;
        border-top-right-radius: 4px;
        border-bottom-right-radius: 4px;
        background: Theme.glass ? root.accent : @linear-gradient(90deg, root.accent 0%, root.accent.transparentize(45%) 100%);
    }
    // Corner brackets: the rounded corner and 12 px along both edges.
    if Theme.holo: Bracket {
        x: 0;
        y: 0;
        stroke: root.bracket-color;
        commands: "M 0.8 28.8 L 0.8 16.8 A 16 16 0 0 1 16.8 0.8 L 28.8 0.8";
    }
    if Theme.holo: Bracket {
        x: parent.width - 30px;
        y: 0;
        stroke: root.bracket-color;
        commands: "M 1.2 0.8 L 13.2 0.8 A 16 16 0 0 1 29.2 16.8 L 29.2 28.8";
    }
    if Theme.holo: Bracket {
        x: parent.width - 30px;
        y: parent.height - 30px;
        stroke: root.bracket-color;
        commands: "M 29.2 1.2 L 29.2 13.2 A 16 16 0 0 1 13.2 29.2 L 1.2 29.2";
    }
    if Theme.holo: Bracket {
        x: 0;
        y: parent.height - 30px;
        stroke: root.bracket-color;
        commands: "M 28.8 29.2 L 16.8 29.2 A 16 16 0 0 1 0.8 13.2 L 0.8 1.2";
    }
    VerticalLayout {
        padding: root.inner-padding;
        padding-left: root.inner-padding + (root.has-accent && (Theme.holo || Theme.glass) ? 6px : 0px);
        @children
    }
}

// An outlined pill, e.g. "Jetzt", "Im grünen Bereich", "✓ Entschuldigt".
export component StatusPill inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <color> tint: Theme.cyan;
    in property <bool> mono: false;
    height: 24px;
    width: row.preferred-width;
    border-radius: 12px;
    background: tint.transparentize(85%);
    border-width: 1px;
    border-color: tint.transparentize(45%);
    row := HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 4px;
        alignment: center;
        if root.has-icon: Image {
            source: root.icon;
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            colorize: root.tint;
        }
        Text {
            text: root.text;
            color: root.tint;
            font-family: root.mono ? Theme.font-mono : Theme.font-body;
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// A circular gauge for a grade on the 1–10 scale (NeonRing).
export component NeonRing inherits Rectangle {
    in property <float> value; // 0 = no grade
    in property <string> label;
    in property <length> size: 44px;
    in property <length> stroke: 3.5px;
    in property <length> font-size: 13px;
    property <color> ring-color: value == 0 ? Theme.violet : (value < 6 ? Theme.danger : (value < 7 ? Theme.warning : (value < 8.5 ? Theme.violet : Theme.cyan)));
    property <float> f: clamp(value / 10, 0, 0.999);
    property <float> s: size / 1px;
    property <float> r: (size - stroke) / 2px;
    property <float> c: s / 2;
    width: size;
    height: size;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: root.s;
        viewbox-height: root.s;
        stroke: root.ring-color.transparentize(78%);
        stroke-width: root.stroke;
        fill: transparent;
        commands: "M " + root.c + " " + (root.c - root.r) + " A " + root.r + " " + root.r + " 0 1 1 " + (root.c - 0.01) + " " + (root.c - root.r);
    }
    if root.value > 0: Path {
        width: root.size;
        height: root.size;
        viewbox-width: root.s;
        viewbox-height: root.s;
        stroke: root.ring-color;
        stroke-width: root.stroke;
        fill: transparent;
        commands: "M " + root.c + " " + (root.c - root.r) + " A " + root.r + " " + root.r + " 0 " + (root.f > 0.5 ? "1" : "0") + " 1 " + (root.c + root.r * Math.sin(root.f * 360deg)) + " " + (root.c - root.r * Math.cos(root.f * 360deg));
    }
    Text {
        text: root.label;
        color: Theme.text;
        font-family: Theme.font-mono;
        font-size: root.font-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Two or more options in a pill; the chosen one glows (HoloToggle).
export component HoloToggle inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    callback chosen(int);
    height: 38px;
    width: row.preferred-width;
    border-radius: 19px;
    background: Theme.surface.transparentize(30%);
    border-width: 1px;
    border-color: Theme.outline;
    row := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in root.options: Rectangle {
            width: label.preferred-width + 36px;
            border-radius: 16px;
            background: i == root.selected ? Theme.accent-gradient : transparent;
            drop-shadow-blur: i == root.selected ? 16px : 0px;
            drop-shadow-color: #7C5CFF73;
            label := Text {
                text: option;
                color: i == root.selected ? #ffffff : Theme.muted;
                font-family: Theme.font-mono;
                font-size: 11.5px;
                font-weight: 700;
                letter-spacing: 1.2px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.chosen(i); }
            }
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.muted;
    in property <length> icon-size: 20px;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: ta.has-hover ? Theme.text.transparentize(92%) : transparent;
    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        colorize: root.tint;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Outlined button with an icon ("Nach Art sortieren").
export component OutlineButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> active: false;
    callback clicked();
    height: 36px;
    width: row.preferred-width;
    border-radius: 10px;
    background: active ? Theme.violet.transparentize(80%) : (ta.has-hover ? Theme.surface-high : Theme.surface.transparentize(30%));
    border-width: 1px;
    border-color: active ? Theme.violet.transparentize(40%) : Theme.outline;
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 14px;
        spacing: 8px;
        if root.has-icon: Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.violet;
        }
        Text {
            text: root.text;
            color: Theme.text.transparentize(15%);
            font-family: Theme.font-body;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The filled violet button, also used floating ("Abwesenheit melden").
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    in property <bool> busy: false;
    callback clicked();
    height: 44px;
    border-radius: 14px;
    background: touch.has-hover ? Theme.violet.brighter(8%) : Theme.violet;
    opacity: enabled ? 1.0 : 0.45;
    drop-shadow-blur: 14px;
    drop-shadow-color: #00000066;
    drop-shadow-offset-y: 3px;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 20px;
        spacing: 10px;
        alignment: center;
        if root.has-icon: Image {
            source: root.icon;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            colorize: #ffffff;
        }
        Text {
            text: root.busy ? "…" : root.text;
            color: #ffffff;
            font-family: Theme.font-body;
            font-size: 14px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled && !root.busy;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component TextButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    callback clicked();
    height: 34px;
    width: row.preferred-width;
    border-radius: 8px;
    background: ta.has-hover ? Theme.violet.transparentize(88%) : transparent;
    row := HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        if root.has-icon: Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.violet;
        }
        Text {
            text: root.text;
            color: Theme.violet;
            font-family: Theme.font-body;
            font-size: 13.5px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A text field in the app's style.
export component Field inherits Rectangle {
    in property <string> placeholder;
    in property <bool> password: false;
    in-out property <string> text <=> input.text;
    callback accepted();
    callback edited(string);
    height: 48px;
    border-radius: 12px;
    background: Theme.surface.transparentize(20%);
    border-width: 1px;
    border-color: input.has-focus ? Theme.violet : Theme.outline;
    Text {
        x: 14px;
        text: root.placeholder;
        visible: input.text == "";
        color: Theme.muted.transparentize(30%);
        font-family: Theme.font-body;
        font-size: 14px;
        vertical-alignment: center;
        height: parent.height;
    }
    input := TextInput {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        vertical-alignment: center;
        color: Theme.text;
        font-family: Theme.font-body;
        font-size: 14px;
        input-type: root.password ? InputType.password : InputType.text;
        single-line: true;
        accepted => { root.accepted(); }
        edited => { root.edited(self.text); }
    }
}

// A bar from 0 to 100 %.
export component Meter inherits Rectangle {
    in property <float> fraction;
    in property <color> tint: Theme.success;
    height: 8px;
    border-radius: 4px;
    background: Theme.outline;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.fraction, 0.015, 1.0);
        height: parent.height;
        border-radius: 4px;
        background: root.tint;
        animate width { duration: 400ms; easing: ease-out; }
    }
}

// Shown while a page has nothing to show.
export component EmptyState inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> text;
    alignment: center;
    spacing: 8px;
    padding: 36px;
    HorizontalLayout {
        alignment: center;
        Image {
            source: root.icon;
            width: 40px;
            height: 40px;
            colorize: Theme.violet;
        }
    }
    Text {
        text: root.title;
        font-family: Theme.font-display;
        font-size: 17px;
        font-weight: 600;
        color: Theme.text;
        horizontal-alignment: center;
    }
    if root.text != "": Text {
        text: root.text;
        font-family: Theme.font-body;
        font-size: 14px;
        color: Theme.muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

// Text with the violet-to-cyan gradient (GradientText).
export component GradientTitle inherits Text {
    color: Theme.accent-gradient;
    font-family: Theme.font-display;
    font-weight: 700;
}
