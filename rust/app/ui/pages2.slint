import { Theme } from "theme.slint";
import { AppData, Nav, Lesson, AbsenceItem, DetailCard, TeacherView, MessageItem } from "data.slint";
import { GlowCard, HoloPanel, HudLabel, SectionLabel, StatusPill, NeonRing, IconButton, OutlineButton, PrimaryButton, TextButton, Meter, EmptyState, Field, HoloToggle } from "widgets.slint";
import { Page, AbsenceMeter, AbsenceYearOutlook } from "pages.slint";
import { Switch, SpinBox, ScrollView, Spinner } from "std-widgets.slint";

// --- Grades ---------------------------------------------------------------

// --- Calendar -------------------------------------------------------------

component LessonCell inherits Rectangle {
    in property <Lesson> lesson;
    in property <int> day;
    property <int> longest-teacher: lesson.teacher-width;
    property <color> edge: lesson.has-test ? Theme.danger : (lesson.is-now ? Theme.cyan : lesson.color);
    border-radius: 6px;
    background: lesson.selected ? Theme.primary.transparentize(78%) : (lesson.is-now ? Theme.cyan.transparentize(80%) : Theme.surface.transparentize(Theme.dark ? 30% : 12%));
    border-width: 1px;
    border-color: lesson.selected ? Theme.primary.transparentize(30%) : Theme.outline;
    clip: true;
    // Subject icons, or in the brainrot look the teacher's picture.
    if !Theme.brainrot: Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: lesson.pattern;
        image-fit: preserve;
        horizontal-alignment: left;
        vertical-alignment: top;
    }
    if Theme.brainrot && lesson.has-photo: Image {
        width: parent.width;
        height: parent.height;
        source: lesson.photo;
        image-fit: cover;
        vertical-alignment: top;
    }
    if Theme.brainrot && lesson.has-photo: Rectangle {
        background: @linear-gradient(180deg, Theme.surface.transparentize(55%) 0%, Theme.surface.transparentize(20%) 100%);
    }
    Rectangle {
        x: 0;
        width: lesson.has-test || lesson.is-now ? 4px : 3px;
        height: parent.height;
        background: root.edge;
    }
    VerticalLayout {
        alignment: center;
        padding-left: 6px;
        padding-right: 3px;
        spacing: 1px;
        if lesson.is-now: HudLabel {
            text: "JETZT";
            color: Theme.cyan;
            horizontal-alignment: center;
        }
        // Long names shrink to fit instead of being cut (FittedBox).
        Text {
            text: lesson.nick;
            color: Theme.text;
            font-family: Theme.font-body;
            font-size: min(13px, (root.width - 12px) * 1.8 / max(1, lesson.nick.character-count));
            font-weight: 700;
            horizontal-alignment: center;
        }
        if lesson.teachers != "": Text {
            text: lesson.teachers;
            color: Theme.muted;
            font-family: Theme.font-mono;
            font-size: min(10px, (root.width - 12px) * 1.6 / max(1, root.longest-teacher));
            horizontal-alignment: center;
        }
        if lesson.rooms != "": Text {
            text: lesson.rooms;
            color: Theme.muted;
            font-family: Theme.font-mono;
            font-size: min(10px, (root.width - 12px) * 1.6 / max(1, lesson.rooms.character-count));
            horizontal-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { AppData.select-lesson(root.day, lesson.index); }
    }
}

component WeekGrid inherits Page {
    property <length> hour-height: 52px;
    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        IconButton {
            icon: @image-url("icons/chevron_left.svg");
            tint: Theme.violet;
            clicked => { AppData.move-week(-1); }
        }
        Text {
            text: AppData.week-title;
            color: Theme.violet;
            font-family: Theme.font-mono;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { AppData.move-week(0); }
            }
        }
        IconButton {
            icon: @image-url("icons/chevron_right.svg");
            tint: Theme.violet;
            clicked => { AppData.move-week(1); }
        }
    }
    HorizontalLayout {
        spacing: 4px;
        for day[d] in AppData.week: VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            Rectangle {
                height: 36px;
                border-radius: 8px;
                background: day.is-today ? Theme.accent-gradient : transparent;
                drop-shadow-blur: day.is-today && Theme.holo ? 14px : 0px;
                drop-shadow-color: Theme.violet.transparentize(55%);
                VerticalLayout {
                    alignment: center;
                    HudLabel {
                        text: day.weekday;
                        color: day.is-today ? #ffffff : Theme.muted;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: day.date;
                        color: day.is-today ? #ffffff : Theme.text;
                        font-family: Theme.font-mono;
                        font-size: 11.5px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }
            }
            Rectangle {
                height: AppData.week-hours * root.hour-height;
                for lesson in day.lessons: LessonCell {
                    y: (lesson.first - 1) * root.hour-height;
                    height: lesson.span * root.hour-height - 2px;
                    width: parent.width;
                    lesson: lesson;
                    day: d;
                }
            }
        }
    }
}

// A round teacher photo with the accent ring, or the initial (_TeacherPhoto).
component TeacherPhoto inherits VerticalLayout {
    in property <TeacherView> teacher;
    in property <int> card;
    in property <int> index;
    spacing: 6px;
    min-width: 120px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 73px;
            height: 73px;
            border-radius: 36.5px;
            background: Theme.accent-gradient;
            Rectangle {
                width: 68px;
                height: 68px;
                border-radius: 34px;
                background: Theme.surface;
                clip: true;
                if root.teacher.has-photo: Image {
                    width: 100%;
                    height: 100%;
                    source: root.teacher.photo;
                    image-fit: cover;
                }
                if !root.teacher.has-photo: Text {
                    text: root.teacher.initial;
                    color: Theme.text;
                    font-family: Theme.font-display;
                    font-size: 24px;
                    font-weight: Theme.display-weight;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    Text {
        text: root.teacher.name;
        color: Theme.text;
        font-family: Theme.font-body;
        font-size: 12.5px;
        font-weight: 500;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if Theme.brainrot: HorizontalLayout {
        alignment: center;
        spacing: 2px;
        TextButton {
            text: root.teacher.custom ? "Anderes Bild" : "Eigenes Bild hochladen";
            icon: @image-url("icons/add_photo_alternate.svg");
            has-icon: true;
            clicked => { AppData.pick-teacher-image(root.card, root.index); }
        }
        if root.teacher.custom: IconButton {
            icon: @image-url("icons/undo.svg");
            icon-size: 18px;
            clicked => { AppData.reset-teacher-image(root.card, root.index); }
        }
    }
}

component DetailLine inherits HorizontalLayout {
    in property <int> icon;
    in property <string> title;
    in property <string> content;
    spacing: 10px;
    VerticalLayout {
        padding-top: 2px;
        Image {
            width: 20px;
            height: 20px;
            source: root.icon == 0 ? @image-url("icons/schedule.svg") : (root.icon == 1 ? @image-url("icons/person.svg") : (root.icon == 2 ? @image-url("icons/people.svg") : (root.icon == 3 ? @image-url("icons/meeting_room.svg") : (root.icon == 4 ? @image-url("icons/school.svg") : (root.icon == 5 ? @image-url("icons/bolt.svg") : @image-url("icons/assignment.svg"))))));
            colorize: root.icon == 5 ? Theme.danger : Theme.primary;
        }
        Rectangle { }
    }
    VerticalLayout {
        spacing: 2px;
        horizontal-stretch: 1;
        HudLabel { text: root.title; }
        Text {
            text: root.content;
            color: Theme.text;
            font-family: Theme.font-body;
            font-size: 14px;
            wrap: word-wrap;
        }
    }
}

// The lesson in detail (CalendarCard).
export component LessonDetail inherits HoloPanel {
    in property <DetailCard> card;
    in property <int> index;
    has-accent: true;
    accent: card.color;
    highlighted: card.selected;
    inner-padding: 16px;
    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            // SubjectGlyph
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 13px;
                background: root.card.color.transparentize(84%);
                border-width: 1.4px;
                border-color: root.card.color.transparentize(30%);
                Text {
                    text: root.card.letter;
                    color: root.card.color.mix(#ffffff, 65%);
                    font-family: "Sora";
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.card.subject;
                color: Theme.text;
                font-family: Theme.font-display;
                font-size: 21px;
                font-weight: Theme.display-weight;
                letter-spacing: Theme.display-spacing;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        DetailLine {
            icon: 0;
            title: root.card.hours;
            content: root.card.times;
        }
        // Side by side; with the upload buttons of the brainrot look they
        // do not fit next to each other and go one below the other (Wrap).
        if root.card.teachers.length > 0 && !Theme.brainrot: HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for t[i] in root.card.teachers: TeacherPhoto {
                teacher: t;
                card: root.index;
                index: i;
            }
        }
        if root.card.teachers.length > 0 && Theme.brainrot: VerticalLayout {
            spacing: 12px;
            for t[i] in root.card.teachers: HorizontalLayout {
                alignment: start;
                TeacherPhoto {
                    width: self.preferred-width;
                    teacher: t;
                    card: root.index;
                    index: i;
                }
            }
        }
        for row in root.card.rows: DetailLine {
            icon: row.icon;
            title: row.title;
            content: row.content;
        }
    }
}

// The day's lessons next to the calendar (RightSidebar / CalendarDetail).
component DetailPanel inherits Rectangle {
    VerticalLayout {
        Rectangle {
            height: 52px;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 8px;
                spacing: 4px;
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/chevron_right.svg");
                    tint: Theme.text;
                    icon-size: 26px;
                    clicked => { AppData.close-detail(); }
                }
                Text {
                    text: AppData.detail-title;
                    color: Theme.text;
                    font-family: Theme.font-display;
                    font-size: 19px;
                    font-weight: Theme.display-weight;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/chevron_left.svg");
                    tint: Theme.text;
                    clicked => { AppData.detail-move(-1); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/chevron_right.svg");
                    tint: Theme.text;
                    clicked => { AppData.detail-move(1); }
                }
            }
        }
        ScrollView {
            VerticalLayout {
                padding: 8px;
                spacing: 12px;
                if AppData.detail-cards.length == 0: EmptyState {
                    icon: @image-url("icons/calendar_today.svg");
                    title: "Kein Unterricht";
                    text: "";
                }
                for card[i] in AppData.detail-cards: LessonDetail {
                    card: card;
                    index: i;
                }
            }
        }
    }
}

export component CalendarPage inherits Rectangle {
    property <bool> side-by-side: self.width >= 820px;
    HorizontalLayout {
        if !AppData.detail-open || root.side-by-side: WeekGrid { }
        if AppData.detail-open: DetailPanel {
            width: root.side-by-side ? 340px : root.width;
        }
    }
}

// --- Absences -------------------------------------------------------------

component AbsencePanel inherits HoloPanel {
    in property <AbsenceItem> item;
    in property <bool> removable: false;
    property <color> tint: item.level == 0 ? Theme.success : (item.level == 1 ? Theme.warning : (item.level == 2 ? Theme.danger : Theme.cyan));
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: item.title;
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 16px;
                font-weight: 500;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            StatusPill {
                text: item.status;
                tint: root.tint;
                has-icon: true;
                icon: item.level == 3 ? @image-url("icons/school.svg") : (item.level == 0 ? @image-url("icons/check.svg") : @image-url("icons/schedule.svg"));
            }
        }
        Text {
            text: item.subtitle;
            color: Theme.muted;
            font-family: Theme.font-body;
            font-size: 12px;
        }
        if item.reason != "": Text {
            text: item.reason;
            color: Theme.text;
            font-family: Theme.font-body;
            font-size: 14px;
            wrap: word-wrap;
        }
        Rectangle { height: 8px; }
        HorizontalLayout {
            Text {
                text: item.footer;
                color: Theme.muted;
                font-family: Theme.font-body;
                font-size: 12px;
                vertical-alignment: center;
            }
            Rectangle { }
            if root.removable: IconButton {
                icon: @image-url("icons/delete_outline.svg");
                clicked => { AppData.remove-future-absence(item.index); }
            }
        }
    }
}

component Count inherits VerticalLayout {
    in property <string> value;
    in property <string> label;
    in property <color> tint: Theme.text;
    spacing: 2px;
    Text {
        text: root.value;
        color: root.tint;
        font-family: Theme.font-display;
        font-size: 20px;
        font-weight: 600;
    }
    Text {
        text: root.label;
        color: Theme.muted;
        font-family: Theme.font-body;
        font-size: 12px;
    }
}

export component AbsencesPage inherits Page {
    property <color> level-color: AppData.absence-level == 0 ? Theme.success : (AppData.absence-level == 1 ? Theme.warning : Theme.danger);

    GlowCard {
        VerticalLayout {
            spacing: 10px;
            Text {
                text: "ABWESENHEIT";
                color: Theme.muted;
                font-family: Theme.font-body;
                font-size: 11.5px;
                font-weight: 500;
                letter-spacing: 1px;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: AppData.absence-percent == "" ? "–" : AppData.absence-percent;
                    color: Theme.accent-gradient;
                    font-family: Theme.font-display;
                    font-size: 30px;
                    font-weight: 700;
                    horizontal-stretch: 0;
                }
                VerticalLayout {
                    alignment: end;
                    padding-bottom: 6px;
                    horizontal-stretch: 0;
                    Text {
                        text: "der Unterrichtszeit";
                        color: Theme.muted;
                        font-family: Theme.font-body;
                        font-size: 12px;
                    }
                }
                Rectangle { }
            }
            AbsenceMeter { }
            if AppData.year-detail != "": AbsenceYearOutlook { }
            HorizontalLayout {
                spacing: 24px;
                padding-top: 6px;
                Count {
                    value: AppData.count-absences;
                    label: "Absenzen";
                }
                Count {
                    value: AppData.count-justified;
                    label: "Entschuldigt";
                    tint: Theme.success;
                }
                Count {
                    value: AppData.count-not-justified;
                    label: "Nicht entsch.";
                }
                Count {
                    value: AppData.count-delayed;
                    label: "Verspätungen";
                    tint: Theme.warning;
                }
                Rectangle { }
            }
        }
    }

    if AppData.future-absences.length > 0: SectionLabel { text: "IM VORAUS GEMELDET"; }
    for item in AppData.future-absences: AbsencePanel {
        item: item;
        removable: AppData.absence-can-edit;
    }

    SectionLabel { text: "ABSENZEN"; }
    if AppData.absences.length == 0: EmptyState {
        icon: @image-url("icons/hotel.svg");
        title: "Keine Absenzen";
        text: "Du hast bisher nichts verpasst.";
    }
    for item in AppData.absences: AbsencePanel { item: item; }
}

// The sheet for reporting an absence in advance.
export component AbsenceForm inherits Rectangle {
    background: #00000099;
    TouchArea {
        clicked => { Nav.absence-form = false; }
    }
    GlowCard {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(460px, parent.width - 24px);
        TouchArea { }
        VerticalLayout {
            spacing: 10px;
            Text {
                text: "Abwesenheit melden";
                color: Theme.text;
                font-family: Theme.font-display;
                font-size: 20px;
                font-weight: 600;
            }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    spacing: 4px;
                    HudLabel { text: "VON"; }
                    from-date := Field {
                        text: AppData.tomorrow-date;
                        placeholder: "TT.MM.JJJJ";
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    HudLabel { text: "BIS"; }
                    to-date := Field {
                        text: AppData.tomorrow-date;
                        placeholder: "TT.MM.JJJJ";
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    spacing: 4px;
                    HudLabel { text: "AB STUNDE"; }
                    first-hour := SpinBox {
                        minimum: 1;
                        maximum: 12;
                        value: 1;
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    HudLabel { text: "BIS STUNDE"; }
                    last-hour := SpinBox {
                        minimum: 1;
                        maximum: 12;
                        value: 8;
                    }
                }
            }
            reason := Field { placeholder: "Grund, z. B. Arzttermin"; }
            signature := Field {
                text: AppData.full-name;
                placeholder: "Unterschrift";
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                TextButton {
                    text: "Abbrechen";
                    clicked => { Nav.absence-form = false; }
                }
                PrimaryButton {
                    width: 120px;
                    text: "Melden";
                    busy: AppData.busy;
                    enabled: from-date.text != "" && reason.text != "" && signature.text != "";
                    clicked => {
                        AppData.report-absence(from-date.text, to-date.text, first-hour.value, last-hour.value, reason.text, signature.text);
                        Nav.absence-form = false;
                    }
                }
            }
        }
    }
}

// --- Messages -------------------------------------------------------------

// "Von   Max Mustermann" in an opened message.
component MetaLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    padding-bottom: 6px;
    HudLabel {
        width: 72px;
        text: root.label;
    }
    Text {
        text: root.value;
        color: Theme.text;
        font-family: Theme.font-body;
        font-size: 14px;
        wrap: word-wrap;
    }
}

// One message (MessageWidget): a tile that opens on a click.
component MessageCard inherits HoloPanel {
    in property <MessageItem> m;
    in-out property <bool> open: false;
    // Opened through a notification: stays marked as new.
    in property <bool> shown: false;
    property <bool> is-new: m.unread || shown;
    property <color> tint: is-new ? Theme.cyan : Theme.violet;
    highlighted: is-new;
    has-accent: is-new;
    accent: Theme.cyan;
    inner-padding: 0px;
    VerticalLayout {
        Rectangle {
            head := HorizontalLayout {
                padding-left: 10px;
                padding-right: 12px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    // SubjectGlyph
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 12px;
                        background: root.tint.transparentize(84%);
                        border-width: 1.4px;
                        border-color: root.tint.transparentize(30%);
                        Text {
                            text: m.glyph;
                            color: root.tint.mix(white, 65%);
                            font-family: Theme.font-display;
                            font-size: 18px;
                            font-weight: 700;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: m.subject;
                            color: Theme.text;
                            font-family: Theme.font-body;
                            font-size: 16px;
                            font-weight: 500;
                            wrap: word-wrap;
                        }
                        if root.is-new: VerticalLayout {
                            alignment: center;
                            StatusPill {
                                text: "neu";
                                tint: Theme.cyan;
                            }
                        }
                    }
                    HudLabel { text: m.date; }
                }
                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 24px;
                        height: 24px;
                        source: @image-url("icons/expand_more.svg");
                        colorize: root.open ? Theme.primary : Theme.muted;
                        transform-rotation: root.open ? 180deg : 0deg;
                        animate transform-rotation { duration: 200ms; }
                    }
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.open = !root.open;
                    if root.open && m.unread {
                        AppData.mark-read(m.id);
                    }
                }
            }
        }
        if root.open: VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-bottom: 16px;
            Rectangle {
                height: 1px;
                background: Theme.outline;
            }
            Rectangle { height: 16px; }
            MetaLine { label: "Von"; value: m.from; }
            MetaLine { label: "An"; value: m.recipients; }
            MetaLine { label: "Gesendet"; value: m.sent; }
            Rectangle { height: 8px; }
            Text {
                text: m.text;
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 14px;
                wrap: word-wrap;
            }
            if m.attachments.length > 0: Rectangle { height: 16px; }
            if m.attachments.length > 0: HudLabel {
                text: m.attachments.length > 1 ? "Anhänge" : "Anhang";
            }
            if m.attachments.length > 0: Rectangle { height: 8px; }
            for a in m.attachments: VerticalLayout {
                padding-bottom: 8px;
                Rectangle {
                    border-radius: 12px;
                    background: Theme.surface-high.transparentize(30%);
                    border-width: 1px;
                    border-color: Theme.outline;
                    clip: true;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        spacing: 16px;
                        Image {
                            y: (parent.height - self.height) / 2;
                            width: 24px;
                            height: 24px;
                            source: @image-url("icons/insert_drive_file.svg");
                            colorize: Theme.primary;
                        }
                        Text {
                            text: a.name;
                            color: Theme.text;
                            font-family: Theme.font-body;
                            font-size: 14px;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        VerticalLayout {
                            alignment: center;
                            TextButton {
                                text: "Öffnen";
                                has-icon: true;
                                icon: @image-url("icons/open_in_new.svg");
                                clicked => { AppData.open-attachment(m.id, a.id); }
                            }
                        }
                    }
                    // AnimatedLinearProgressIndicator
                    if a.downloading: Rectangle {
                        y: parent.height - 3px;
                        height: 3px;
                        background: Theme.primary.transparentize(75%);
                        Rectangle {
                            property <float> t: Math.mod(animation-tick() / 1.3s, 1);
                            x: parent.width * (t * 1.4 - 0.4);
                            width: parent.width * 0.4;
                            background: Theme.primary;
                        }
                    }
                }
            }
        }
    }
}

export component MessagesPage inherits Page {
    if AppData.messages.length == 0: VerticalLayout {
        padding-top: 120px;
        spacing: 12px;
        HorizontalLayout {
            alignment: center;
            Image {
                width: 48px;
                height: 48px;
                source: @image-url("icons/mark_email_read.svg");
                colorize: Theme.primary;
            }
        }
        Text {
            text: "Noch keine Mitteilungen";
            color: Theme.text;
            font-family: Theme.font-display;
            font-size: 22px;
            horizontal-alignment: center;
        }
    }
    for m in AppData.messages: MessageCard {
        m: m;
        shown: m.id == AppData.show-message;
        open: m.id == AppData.show-message;
        vertical-stretch: 0;
    }
    Rectangle { vertical-stretch: 1; }
}

// --- Notifications (NotificationPage) ---------------------------------------

export component NotificationsPage inherits Rectangle {
    background: Theme.bg;
    TouchArea { }
    VerticalLayout {
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: 8px;
                spacing: 8px;
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/arrow_back.svg");
                    tint: Theme.text;
                    clicked => { Nav.notifications = false; }
                }
                Text {
                    text: "Benachrichtigungen";
                    color: Theme.text;
                    font-family: Theme.font-display;
                    font-size: 19px;
                    font-weight: Theme.display-weight;
                    vertical-alignment: center;
                }
            }
        }
        if AppData.notifications.length == 0: Text {
            text: "Keine Benachrichtigungen";
            color: Theme.text;
            font-family: Theme.font-display;
            font-size: 28px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if AppData.notifications.length > 0: Page {
            HorizontalLayout {
                alignment: end;
                Rectangle {
                    width: all.preferred-width + 16px;
                    height: 36px;
                    border-radius: 8px;
                    background: all-ta.has-hover ? Theme.violet.transparentize(88%) : transparent;
                    all := HorizontalLayout {
                        x: 8px;
                        spacing: 8px;
                        Text {
                            text: "Alle gelesen";
                            color: Theme.primary;
                            font-family: Theme.font-body;
                            font-size: 14px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                        Image {
                            y: (parent.height - self.height) / 2;
                            width: 24px;
                            height: 24px;
                            source: @image-url("icons/done_all.svg");
                            colorize: Theme.primary;
                        }
                    }
                    all-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppData.delete-all-notifications(); }
                    }
                }
            }
            for n in AppData.notifications: Rectangle {
                vertical-stretch: 0;
                border-radius: 16px;
                border-width: 1px;
                border-color: #9e9e9e;
                HorizontalLayout {
                    padding: 8px;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: n.subject;
                            color: Theme.text;
                            font-family: Theme.font-body;
                            font-size: 16px;
                            font-weight: 500;
                            wrap: word-wrap;
                        }
                        if n.text != "": Text {
                            text: n.text;
                            color: Theme.text;
                            font-family: Theme.font-body;
                            font-size: 14px;
                            wrap: word-wrap;
                        }
                        Text {
                            x: 2px;
                            text: n.date;
                            color: Theme.muted;
                            font-family: Theme.font-body;
                            font-size: 12px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: n.is-message ? @image-url("icons/exit_to_app.svg") : @image-url("icons/done.svg");
                            tint: Theme.text;
                            icon-size: 24px;
                            clicked => {
                                if n.is-message {
                                    AppData.mark-read(n.object-id);
                                    AppData.show-message = n.object-id;
                                    Nav.notifications = false;
                                    Nav.page = 5;
                                } else {
                                    AppData.delete-notification(n.id);
                                }
                            }
                        }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}

// --- Settings -------------------------------------------------------------

// One look in the style picker (_StyleCard).
component StyleCard inherits Rectangle {
    in property <int> style;
    in property <string> title;
    in property <string> subtitle;
    in property <[color]> colors;
    in property <string> emoji;
    property <bool> selected: Theme.style == root.style;
    height: 132px;
    border-radius: 16px;
    background: selected ? Theme.accent-gradient : Theme.outline;
    Rectangle {
        x: root.selected ? 3px : 1.5px;
        y: self.x;
        width: parent.width - 2 * self.x;
        height: parent.height - 2 * self.y;
        border-radius: 13px;
        background: root.colors[0];
        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            HorizontalLayout {
                Text {
                    text: root.emoji;
                    font-size: 22px;
                    color: root.colors[2];
                }
                Rectangle { }
                if root.selected: Image {
                    source: @image-url("icons/check.svg");
                    width: 20px;
                    height: 20px;
                    colorize: root.colors[2];
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for c in root.colors: Rectangle {
                    width: 26px;
                    height: 8px;
                    border-radius: 4px;
                    background: c;
                }
            }
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.title;
                    color: #ffffff;
                    font-family: "Sora";
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: root.subtitle;
                    color: #ffffffb3;
                    font-family: "Inter";
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { Theme.style = root.style; }
    }
}

export component SettingsPage inherits Page {
    property <[color]> accents: [#2563EB, #7C3AED, #DB2777, #DC2626, #EA580C, #CA8A04, #16A34A, #0D9488, #0891B2, #52525B];

    SectionLabel { text: "DESIGN"; }
    HoloPanel {
        VerticalLayout {
            spacing: 12px;
            HudLabel { text: "STIL DER APP"; }
            HorizontalLayout {
                spacing: 12px;
                StyleCard {
                    style: 0;
                    title: "Holo";
                    subtitle: "Futuristisch, clean, leuchtend";
                    colors: [#0A0E1A, #7C5CFF, #22D3EE];
                    emoji: "✦";
                }
                StyleCard {
                    style: 1;
                    title: "Brainrot";
                    subtitle: "Laut, bunt, Meme-Style";
                    colors: [#14001F, #FF2E93, #B6FF00];
                    emoji: "💀";
                }
                StyleCard {
                    style: 2;
                    title: "Israel";
                    subtitle: "Shalom, Sababa, Yalla";
                    colors: [#06102E, #0038B8, #FFFFFF];
                    emoji: "🇮🇱";
                }
            }
            HorizontalLayout {
                spacing: 12px;
                StyleCard {
                    style: 3;
                    title: "Clean";
                    subtitle: "Ruhig, modern, eine Akzentfarbe";
                    colors: [#18181B, #2563EB, #E4E4E7];
                    emoji: "○";
                }
                StyleCard {
                    style: 4;
                    title: "Liquid Glass";
                    subtitle: "Glas, Licht und weiche Farben";
                    colors: [#1C2A4A, #0A84FF, #BF5AF2];
                    emoji: "◐";
                }
                Rectangle { }
            }
            if Theme.clean: VerticalLayout {
                spacing: 10px;
                HudLabel { text: "AKZENTFARBE"; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    for c in root.accents: Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: c;
                        border-width: Theme.accent-choice == c ? 3px : 0px;
                        border-color: Theme.text;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Theme.accent-choice = c; }
                        }
                    }
                }
            }
            Switch {
                text: "Dunkel";
                checked <=> Theme.dark;
            }
        }
    }

    SectionLabel { text: "KONTO"; }
    HoloPanel {
        VerticalLayout {
            spacing: 8px;
            Text {
                text: AppData.full-name;
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: AppData.school;
                color: Theme.muted;
                font-family: Theme.font-body;
                font-size: 13px;
                wrap: word-wrap;
            }
            HudLabel { text: AppData.fetched; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                OutlineButton {
                    text: "Neu laden";
                    clicked => { AppData.refresh(); }
                }
                OutlineButton {
                    text: "Abmelden";
                    clicked => { AppData.logout(); }
                }
            }
        }
    }

    SectionLabel { text: "ÜBER"; }
    HoloPanel {
        VerticalLayout {
            spacing: 4px;
            Text {
                text: "Register · Rust-Version";
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: "Inoffizielle App für das Digitale Register. Die Daten bleiben auf deinem Gerät.";
                color: Theme.muted;
                font-family: Theme.font-body;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }
}

// --- Certificate (Zeugnis) -----------------------------------------------

export component CertificatePage inherits Page {
    if AppData.certificate-state == 0: HorizontalLayout {
        alignment: center;
        padding-top: 60px;
        Spinner {
            indeterminate: true;
            width: 40px;
            height: 40px;
        }
    }
    // NoInternet
    if AppData.certificate-state == 2: VerticalLayout {
        alignment: start;
        padding-top: 80px;
        spacing: 20px;
        Text {
            text: "Keine Verbindung";
            color: #f44336;
            font-family: Theme.font-display;
            font-size: 22px;
            horizontal-alignment: center;
        }
        Text {
            text: ":(";
            color: #ff5252;
            font-size: 50px;
            horizontal-alignment: center;
        }
    }
    if AppData.certificate-state == 1: VerticalLayout {
        alignment: start;
        VerticalLayout {
            padding: 8px;
            spacing: 10px;
            for b in AppData.certificate: VerticalLayout {
                spacing: 4px;
                if b.kind == 0: Text {
                    text: b.text;
                    color: Theme.text;
                    font-family: Theme.font-display;
                    font-weight: 700;
                    font-size: b.level <= 1 ? 26px : (b.level == 2 ? 21px : 17px);
                    wrap: word-wrap;
                }
                if b.kind == 1: Text {
                    text: b.text;
                    color: Theme.text;
                    font-family: Theme.font-body;
                    font-size: 15px;
                    wrap: word-wrap;
                }
                if b.kind == 2: VerticalLayout {
                    for r[ri] in b.rows: Rectangle {
                        background: b.header && ri == 0 ? Theme.cyan.transparentize(85%) : (Math.mod(ri, 2) == 1 ? Theme.outline.transparentize(70%) : transparent);
                        HorizontalLayout {
                            padding: 6px;
                            spacing: 8px;
                            for c[ci] in r.cells: Text {
                                horizontal-stretch: ci == 0 ? 2 : 1;
                                text: c;
                                color: Theme.text;
                                font-family: Theme.font-body;
                                font-size: 14px;
                                font-weight: b.header && ri == 0 ? 700 : 400;
                                horizontal-alignment: ci == 0 ? left : center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
    Rectangle { vertical-stretch: 1; }
}
