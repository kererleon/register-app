import { Theme } from "theme.slint";
import { AppData, Nav, Lesson, AbsenceItem, DetailCard, TeacherView } from "data.slint";
import { GlowCard, HoloPanel, HudLabel, SectionLabel, StatusPill, NeonRing, IconButton, OutlineButton, PrimaryButton, TextButton, Meter, EmptyState, Field, HoloToggle } from "widgets.slint";
import { Page, AbsenceMeter, AbsenceYearOutlook } from "pages.slint";
import { Switch, SpinBox, ScrollView } from "std-widgets.slint";

// --- Grades ---------------------------------------------------------------

component Chart inherits Rectangle {
    height: 140px;
    property <length> left: 22px;
    property <length> plot-width: self.width - self.left;
    property <length> plot-height: self.height - 20px;
    // Grid lines and labels for the grades 3 to 10.
    for g[i] in [10, 9, 8, 7, 6, 5, 4, 3]: Rectangle {
        y: root.plot-height * i / 7;
        height: 1px;
        Rectangle {
            x: root.left;
            width: root.plot-width;
            height: 1px;
            background: Theme.outline;
        }
        Text {
            x: 0;
            y: -6px;
            text: g;
            color: Theme.text.transparentize(15%);
            font-family: Theme.font-body;
            font-size: 10px;
        }
    }
    for line in AppData.chart: Rectangle {
        x: root.left;
        width: root.plot-width;
        height: root.plot-height;
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 1000;
            viewbox-height: 100;
            stroke: line.color;
            stroke-width: 2px;
            fill: transparent;
            commands: line.commands;
        }
        if line.dots != "": Path {
            width: 100%;
            height: 100%;
            viewbox-width: 1000;
            viewbox-height: 100;
            fill: line.color;
            stroke-width: 0px;
            commands: line.dots;
        }
    }
    Text {
        x: root.left - 16px;
        y: root.plot-height + 6px;
        text: AppData.chart-from;
        color: Theme.text;
        font-family: Theme.font-body;
        font-size: 10px;
    }
    Text {
        x: root.width - self.width;
        y: root.plot-height + 6px;
        text: AppData.chart-to;
        color: Theme.text;
        font-family: Theme.font-body;
        font-size: 10px;
    }
}

export component GradesPage inherits Page {
    in-out property <int> open: -1;

    GlowCard {
        VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                spacing: 16px;
                NeonRing {
                    size: 76px;
                    stroke: 6px;
                    font-size: 22px;
                    value: AppData.overall-value;
                    label: AppData.overall;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    HudLabel { text: "GESAMTDURCHSCHNITT"; }
                    Text {
                        text: AppData.semester == 0 ? "1. Semester" : (AppData.semester == 1 ? "2. Semester" : "Ganzes Jahr");
                        color: Theme.text;
                        font-family: Theme.font-display;
                        font-size: 21px;
                        font-weight: 600;
                    }
                    Text {
                        text: AppData.overall-note;
                        color: AppData.overall-value == 0 ? Theme.violet : (AppData.overall-value < 6 ? Theme.danger : (AppData.overall-value < 7 ? Theme.warning : (AppData.overall-value < 8.5 ? Theme.violet : Theme.cyan)));
                        font-family: Theme.font-body;
                        font-size: 12.5px;
                    }
                }
                Rectangle { }
            }
            if AppData.chart.length > 0: VerticalLayout {
                spacing: 8px;
                HudLabel { text: "VERLAUF"; }
                Chart { }
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        OutlineButton {
            text: "Nach Art sortieren";
            icon: @image-url("icons/sort.svg");
            has-icon: true;
            active: AppData.sort-by-type;
            clicked => { AppData.set-sort-by-type(!AppData.sort-by-type); }
        }
        OutlineButton {
            text: AppData.show-cancelled ? "Gelöschte ausblenden" : "Gelöschte anzeigen";
            icon: @image-url("icons/delete_outline.svg");
            has-icon: true;
            active: AppData.show-cancelled;
            clicked => { AppData.set-show-cancelled(!AppData.show-cancelled); }
        }
    }

    SectionLabel { text: "FÄCHER"; }
    if AppData.subjects.length == 0: EmptyState {
        icon: @image-url("icons/star.svg");
        title: "Noch keine Noten";
        text: "Sobald Noten eingetragen sind, erscheinen sie hier.";
    }
    for subject[i] in AppData.subjects: HoloPanel {
        clickable: true;
        has-accent: true;
        accent: subject.color;
        inner-padding: 10px;
        clicked => {
            if root.open == i {
                root.open = -1;
            } else {
                root.open = i;
                AppData.open-subject(subject.id);
            }
        }
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 12px;
                NeonRing {
                    size: 38px;
                    stroke: 3px;
                    font-size: 11px;
                    value: subject.average-value;
                    label: subject.average;
                }
                Text {
                    text: subject.name;
                    color: Theme.text;
                    font-family: Theme.font-body;
                    font-size: 15px;
                    vertical-alignment: center;
                }
                if subject.test-chip != "": StatusPill {
                    y: (parent.height - self.height) / 2;
                    text: subject.test-chip;
                    icon: @image-url("icons/bolt.svg");
                    has-icon: true;
                }
                Rectangle { }
                Image {
                    width: 22px;
                    height: 22px;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("icons/expand_more.svg");
                    colorize: Theme.muted;
                    transform-rotation: root.open == i ? 180deg : 0deg;
                }
            }
            if root.open == i && subject.forecast != "": Text {
                text: subject.forecast;
                color: Theme.cyan;
                font-family: Theme.font-body;
                font-size: 12.5px;
                wrap: word-wrap;
            }
            if root.open == i: VerticalLayout {
                spacing: 2px;
                for grade in subject.grades: HorizontalLayout {
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 12px;
                    Text {
                        width: 48px;
                        text: grade.value;
                        color: grade.cancelled ? Theme.muted : Theme.violet;
                        font-family: Theme.font-mono;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        spacing: 1px;
                        Text {
                            text: grade.title;
                            color: grade.cancelled ? Theme.muted : Theme.text;
                            font-family: Theme.font-body;
                            font-size: 14px;
                            wrap: word-wrap;
                        }
                        Text {
                            text: grade.date + "  ·  " + grade.weight + (grade.cancelled ? "  ·  gelöscht" : "");
                            color: Theme.muted;
                            font-family: Theme.font-mono;
                            font-size: 11px;
                        }
                        if grade.detail != "": Text {
                            text: grade.detail;
                            color: Theme.muted;
                            font-family: Theme.font-body;
                            font-size: 12.5px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

// --- Calendar -------------------------------------------------------------

component LessonCell inherits Rectangle {
    in property <Lesson> lesson;
    in property <int> day;
    property <int> longest-teacher: lesson.teacher-width;
    property <color> edge: lesson.has-test ? Theme.danger : (lesson.is-now ? Theme.cyan : lesson.color);
    border-radius: 6px;
    background: lesson.selected ? Theme.primary.transparentize(78%) : (lesson.is-now ? Theme.cyan.transparentize(80%) : Theme.surface.transparentize(Theme.dark ? 30% : 12%));
    border-width: 1px;
    border-color: lesson.selected ? Theme.primary.transparentize(30%) : Theme.outline;
    clip: true;
    // Subject icons, or in the brainrot look the teacher's picture.
    if !Theme.brainrot: Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        source: lesson.pattern;
        image-fit: preserve;
        horizontal-alignment: left;
        vertical-alignment: top;
    }
    if Theme.brainrot && lesson.has-photo: Image {
        width: parent.width;
        height: parent.height;
        source: lesson.photo;
        image-fit: cover;
        vertical-alignment: top;
    }
    if Theme.brainrot && lesson.has-photo: Rectangle {
        background: @linear-gradient(180deg, Theme.surface.transparentize(55%) 0%, Theme.surface.transparentize(20%) 100%);
    }
    Rectangle {
        x: 0;
        width: lesson.has-test || lesson.is-now ? 4px : 3px;
        height: parent.height;
        background: root.edge;
    }
    VerticalLayout {
        alignment: center;
        padding-left: 6px;
        padding-right: 3px;
        spacing: 1px;
        if lesson.is-now: HudLabel {
            text: "JETZT";
            color: Theme.cyan;
            horizontal-alignment: center;
        }
        // Long names shrink to fit instead of being cut (FittedBox).
        Text {
            text: lesson.nick;
            color: Theme.text;
            font-family: Theme.font-body;
            font-size: min(13px, (root.width - 12px) * 1.8 / max(1, lesson.nick.character-count));
            font-weight: 700;
            horizontal-alignment: center;
        }
        if lesson.teachers != "": Text {
            text: lesson.teachers;
            color: Theme.muted;
            font-family: Theme.font-mono;
            font-size: min(10px, (root.width - 12px) * 1.6 / max(1, root.longest-teacher));
            horizontal-alignment: center;
        }
        if lesson.rooms != "": Text {
            text: lesson.rooms;
            color: Theme.muted;
            font-family: Theme.font-mono;
            font-size: min(10px, (root.width - 12px) * 1.6 / max(1, lesson.rooms.character-count));
            horizontal-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { AppData.select-lesson(root.day, lesson.index); }
    }
}

component WeekGrid inherits Page {
    property <length> hour-height: 52px;
    HorizontalLayout {
        alignment: center;
        spacing: 12px;
        IconButton {
            icon: @image-url("icons/chevron_left.svg");
            tint: Theme.violet;
            clicked => { AppData.move-week(-1); }
        }
        Text {
            text: AppData.week-title;
            color: Theme.violet;
            font-family: Theme.font-mono;
            font-size: 15px;
            font-weight: 600;
            vertical-alignment: center;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { AppData.move-week(0); }
            }
        }
        IconButton {
            icon: @image-url("icons/chevron_right.svg");
            tint: Theme.violet;
            clicked => { AppData.move-week(1); }
        }
    }
    HorizontalLayout {
        spacing: 4px;
        for day[d] in AppData.week: VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            Rectangle {
                height: 36px;
                border-radius: 8px;
                background: day.is-today ? Theme.accent-gradient : transparent;
                drop-shadow-blur: day.is-today && Theme.holo ? 14px : 0px;
                drop-shadow-color: Theme.violet.transparentize(55%);
                VerticalLayout {
                    alignment: center;
                    HudLabel {
                        text: day.weekday;
                        color: day.is-today ? #ffffff : Theme.muted;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: day.date;
                        color: day.is-today ? #ffffff : Theme.text;
                        font-family: Theme.font-mono;
                        font-size: 11.5px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }
            }
            Rectangle {
                height: AppData.week-hours * root.hour-height;
                for lesson in day.lessons: LessonCell {
                    y: (lesson.first - 1) * root.hour-height;
                    height: lesson.span * root.hour-height - 2px;
                    width: parent.width;
                    lesson: lesson;
                    day: d;
                }
            }
        }
    }
}

// A round teacher photo with the accent ring, or the initial (_TeacherPhoto).
component TeacherPhoto inherits VerticalLayout {
    in property <TeacherView> teacher;
    in property <int> card;
    in property <int> index;
    spacing: 6px;
    min-width: 120px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 73px;
            height: 73px;
            border-radius: 36.5px;
            background: Theme.accent-gradient;
            Rectangle {
                width: 68px;
                height: 68px;
                border-radius: 34px;
                background: Theme.surface;
                clip: true;
                if root.teacher.has-photo: Image {
                    width: 100%;
                    height: 100%;
                    source: root.teacher.photo;
                    image-fit: cover;
                }
                if !root.teacher.has-photo: Text {
                    text: root.teacher.initial;
                    color: Theme.text;
                    font-family: Theme.font-display;
                    font-size: 24px;
                    font-weight: Theme.display-weight;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    Text {
        text: root.teacher.name;
        color: Theme.text;
        font-family: Theme.font-body;
        font-size: 12.5px;
        font-weight: 500;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if Theme.brainrot: HorizontalLayout {
        alignment: center;
        spacing: 2px;
        TextButton {
            text: root.teacher.custom ? "Anderes Bild" : "Eigenes Bild hochladen";
            icon: @image-url("icons/add_photo_alternate.svg");
            has-icon: true;
            clicked => { AppData.pick-teacher-image(root.card, root.index); }
        }
        if root.teacher.custom: IconButton {
            icon: @image-url("icons/undo.svg");
            icon-size: 18px;
            clicked => { AppData.reset-teacher-image(root.card, root.index); }
        }
    }
}

component DetailLine inherits HorizontalLayout {
    in property <int> icon;
    in property <string> title;
    in property <string> content;
    spacing: 10px;
    VerticalLayout {
        padding-top: 2px;
        Image {
            width: 20px;
            height: 20px;
            source: root.icon == 0 ? @image-url("icons/schedule.svg") : (root.icon == 1 ? @image-url("icons/person.svg") : (root.icon == 2 ? @image-url("icons/people.svg") : (root.icon == 3 ? @image-url("icons/meeting_room.svg") : (root.icon == 4 ? @image-url("icons/school.svg") : (root.icon == 5 ? @image-url("icons/bolt.svg") : @image-url("icons/assignment.svg"))))));
            colorize: root.icon == 5 ? Theme.danger : Theme.primary;
        }
        Rectangle { }
    }
    VerticalLayout {
        spacing: 2px;
        horizontal-stretch: 1;
        HudLabel { text: root.title; }
        Text {
            text: root.content;
            color: Theme.text;
            font-family: Theme.font-body;
            font-size: 14px;
            wrap: word-wrap;
        }
    }
}

// The lesson in detail (CalendarCard).
export component LessonDetail inherits HoloPanel {
    in property <DetailCard> card;
    in property <int> index;
    has-accent: true;
    accent: card.color;
    highlighted: card.selected;
    inner-padding: 16px;
    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            // SubjectGlyph
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 13px;
                background: root.card.color.transparentize(84%);
                border-width: 1.4px;
                border-color: root.card.color.transparentize(30%);
                Text {
                    text: root.card.letter;
                    color: root.card.color.mix(#ffffff, 65%);
                    font-family: "Sora";
                    font-size: 20px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.card.subject;
                color: Theme.text;
                font-family: Theme.font-display;
                font-size: 21px;
                font-weight: Theme.display-weight;
                letter-spacing: Theme.display-spacing;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        DetailLine {
            icon: 0;
            title: root.card.hours;
            content: root.card.times;
        }
        // Side by side; with the upload buttons of the brainrot look they
        // do not fit next to each other and go one below the other (Wrap).
        if root.card.teachers.length > 0 && !Theme.brainrot: HorizontalLayout {
            spacing: 4px;
            alignment: start;
            for t[i] in root.card.teachers: TeacherPhoto {
                teacher: t;
                card: root.index;
                index: i;
            }
        }
        if root.card.teachers.length > 0 && Theme.brainrot: VerticalLayout {
            spacing: 12px;
            for t[i] in root.card.teachers: HorizontalLayout {
                alignment: start;
                TeacherPhoto {
                    width: self.preferred-width;
                    teacher: t;
                    card: root.index;
                    index: i;
                }
            }
        }
        for row in root.card.rows: DetailLine {
            icon: row.icon;
            title: row.title;
            content: row.content;
        }
    }
}

// The day's lessons next to the calendar (RightSidebar / CalendarDetail).
component DetailPanel inherits Rectangle {
    VerticalLayout {
        Rectangle {
            height: 52px;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 8px;
                spacing: 4px;
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/chevron_right.svg");
                    tint: Theme.text;
                    icon-size: 26px;
                    clicked => { AppData.close-detail(); }
                }
                Text {
                    text: AppData.detail-title;
                    color: Theme.text;
                    font-family: Theme.font-display;
                    font-size: 19px;
                    font-weight: Theme.display-weight;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/chevron_left.svg");
                    tint: Theme.text;
                    clicked => { AppData.detail-move(-1); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/chevron_right.svg");
                    tint: Theme.text;
                    clicked => { AppData.detail-move(1); }
                }
            }
        }
        ScrollView {
            VerticalLayout {
                padding: 8px;
                spacing: 12px;
                if AppData.detail-cards.length == 0: EmptyState {
                    icon: @image-url("icons/calendar_today.svg");
                    title: "Kein Unterricht";
                    text: "";
                }
                for card[i] in AppData.detail-cards: LessonDetail {
                    card: card;
                    index: i;
                }
            }
        }
    }
}

export component CalendarPage inherits Rectangle {
    property <bool> side-by-side: self.width >= 820px;
    HorizontalLayout {
        if !AppData.detail-open || root.side-by-side: WeekGrid { }
        if AppData.detail-open: DetailPanel {
            width: root.side-by-side ? 340px : root.width;
        }
    }
}

// --- Absences -------------------------------------------------------------

component AbsencePanel inherits HoloPanel {
    in property <AbsenceItem> item;
    in property <bool> removable: false;
    property <color> tint: item.level == 0 ? Theme.success : (item.level == 1 ? Theme.warning : (item.level == 2 ? Theme.danger : Theme.cyan));
    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: item.title;
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 16px;
                font-weight: 500;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            StatusPill {
                text: item.status;
                tint: root.tint;
                has-icon: true;
                icon: item.level == 3 ? @image-url("icons/school.svg") : (item.level == 0 ? @image-url("icons/check.svg") : @image-url("icons/schedule.svg"));
            }
        }
        Text {
            text: item.subtitle;
            color: Theme.muted;
            font-family: Theme.font-body;
            font-size: 12px;
        }
        if item.reason != "": Text {
            text: item.reason;
            color: Theme.text;
            font-family: Theme.font-body;
            font-size: 14px;
            wrap: word-wrap;
        }
        Rectangle { height: 8px; }
        HorizontalLayout {
            Text {
                text: item.footer;
                color: Theme.muted;
                font-family: Theme.font-body;
                font-size: 12px;
                vertical-alignment: center;
            }
            Rectangle { }
            if root.removable: IconButton {
                icon: @image-url("icons/delete_outline.svg");
                clicked => { AppData.remove-future-absence(item.index); }
            }
        }
    }
}

component Count inherits VerticalLayout {
    in property <string> value;
    in property <string> label;
    in property <color> tint: Theme.text;
    spacing: 2px;
    Text {
        text: root.value;
        color: root.tint;
        font-family: Theme.font-display;
        font-size: 20px;
        font-weight: 600;
    }
    Text {
        text: root.label;
        color: Theme.muted;
        font-family: Theme.font-body;
        font-size: 12px;
    }
}

export component AbsencesPage inherits Page {
    property <color> level-color: AppData.absence-level == 0 ? Theme.success : (AppData.absence-level == 1 ? Theme.warning : Theme.danger);

    GlowCard {
        VerticalLayout {
            spacing: 10px;
            Text {
                text: "ABWESENHEIT";
                color: Theme.muted;
                font-family: Theme.font-body;
                font-size: 11.5px;
                font-weight: 500;
                letter-spacing: 1px;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: AppData.absence-percent == "" ? "–" : AppData.absence-percent;
                    color: Theme.accent-gradient;
                    font-family: Theme.font-display;
                    font-size: 30px;
                    font-weight: 700;
                    horizontal-stretch: 0;
                }
                VerticalLayout {
                    alignment: end;
                    padding-bottom: 6px;
                    horizontal-stretch: 0;
                    Text {
                        text: "der Unterrichtszeit";
                        color: Theme.muted;
                        font-family: Theme.font-body;
                        font-size: 12px;
                    }
                }
                Rectangle { }
            }
            AbsenceMeter { }
            if AppData.year-detail != "": AbsenceYearOutlook { }
            HorizontalLayout {
                spacing: 24px;
                padding-top: 6px;
                Count {
                    value: AppData.count-absences;
                    label: "Absenzen";
                }
                Count {
                    value: AppData.count-justified;
                    label: "Entschuldigt";
                    tint: Theme.success;
                }
                Count {
                    value: AppData.count-not-justified;
                    label: "Nicht entsch.";
                }
                Count {
                    value: AppData.count-delayed;
                    label: "Verspätungen";
                    tint: Theme.warning;
                }
                Rectangle { }
            }
        }
    }

    if AppData.future-absences.length > 0: SectionLabel { text: "IM VORAUS GEMELDET"; }
    for item in AppData.future-absences: AbsencePanel {
        item: item;
        removable: AppData.absence-can-edit;
    }

    SectionLabel { text: "ABSENZEN"; }
    if AppData.absences.length == 0: EmptyState {
        icon: @image-url("icons/hotel.svg");
        title: "Keine Absenzen";
        text: "Du hast bisher nichts verpasst.";
    }
    for item in AppData.absences: AbsencePanel { item: item; }
}

// The sheet for reporting an absence in advance.
export component AbsenceForm inherits Rectangle {
    background: #00000099;
    TouchArea {
        clicked => { Nav.absence-form = false; }
    }
    GlowCard {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(460px, parent.width - 24px);
        TouchArea { }
        VerticalLayout {
            spacing: 10px;
            Text {
                text: "Abwesenheit melden";
                color: Theme.text;
                font-family: Theme.font-display;
                font-size: 20px;
                font-weight: 600;
            }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    spacing: 4px;
                    HudLabel { text: "VON"; }
                    from-date := Field {
                        text: AppData.tomorrow-date;
                        placeholder: "TT.MM.JJJJ";
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    HudLabel { text: "BIS"; }
                    to-date := Field {
                        text: AppData.tomorrow-date;
                        placeholder: "TT.MM.JJJJ";
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    spacing: 4px;
                    HudLabel { text: "AB STUNDE"; }
                    first-hour := SpinBox {
                        minimum: 1;
                        maximum: 12;
                        value: 1;
                    }
                }
                VerticalLayout {
                    spacing: 4px;
                    HudLabel { text: "BIS STUNDE"; }
                    last-hour := SpinBox {
                        minimum: 1;
                        maximum: 12;
                        value: 8;
                    }
                }
            }
            reason := Field { placeholder: "Grund, z. B. Arzttermin"; }
            signature := Field {
                text: AppData.full-name;
                placeholder: "Unterschrift";
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                TextButton {
                    text: "Abbrechen";
                    clicked => { Nav.absence-form = false; }
                }
                PrimaryButton {
                    width: 120px;
                    text: "Melden";
                    busy: AppData.busy;
                    enabled: from-date.text != "" && reason.text != "" && signature.text != "";
                    clicked => {
                        AppData.report-absence(from-date.text, to-date.text, first-hour.value, last-hour.value, reason.text, signature.text);
                        Nav.absence-form = false;
                    }
                }
            }
        }
    }
}

// --- Messages -------------------------------------------------------------

export component MessagesPage inherits Page {
    in-out property <int> open: -1;

    if AppData.notifications.length > 0: SectionLabel { text: "BENACHRICHTIGUNGEN"; }
    for n in AppData.notifications: HoloPanel {
        VerticalLayout {
            spacing: 3px;
            HudLabel { text: n.date; }
            Text {
                text: n.subject;
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 15px;
                font-weight: 500;
                wrap: word-wrap;
            }
            if n.text != "": Text {
                text: n.text;
                color: Theme.muted;
                font-family: Theme.font-body;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }

    SectionLabel { text: "MITTEILUNGEN"; }
    if AppData.messages.length == 0: EmptyState {
        icon: @image-url("icons/chat.svg");
        title: "Keine Mitteilungen";
        text: "";
    }
    for m[i] in AppData.messages: HoloPanel {
        clickable: true;
        highlighted: m.unread;
        clicked => {
            root.open = root.open == i ? -1 : i;
            if m.unread {
                AppData.mark-read(m.id);
            }
        }
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                HudLabel {
                    text: m.from;
                    color: Theme.cyan;
                    overflow: elide;
                }
                Rectangle { }
                HudLabel { text: m.date; }
            }
            Text {
                text: m.subject;
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 15.5px;
                font-weight: m.unread ? 700 : 500;
                wrap: word-wrap;
            }
            Text {
                text: m.text;
                color: Theme.muted;
                font-family: Theme.font-body;
                font-size: 14px;
                wrap: word-wrap;
                height: root.open == i ? self.preferred-height : min(self.preferred-height, 38px);
                overflow: elide;
            }
        }
    }
}

// --- Settings -------------------------------------------------------------

// One look in the style picker (_StyleCard).
component StyleCard inherits Rectangle {
    in property <int> style;
    in property <string> title;
    in property <string> subtitle;
    in property <[color]> colors;
    in property <string> emoji;
    property <bool> selected: Theme.style == root.style;
    height: 132px;
    border-radius: 16px;
    background: selected ? Theme.accent-gradient : Theme.outline;
    Rectangle {
        x: root.selected ? 3px : 1.5px;
        y: self.x;
        width: parent.width - 2 * self.x;
        height: parent.height - 2 * self.y;
        border-radius: 13px;
        background: root.colors[0];
        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            HorizontalLayout {
                Text {
                    text: root.emoji;
                    font-size: 22px;
                    color: root.colors[2];
                }
                Rectangle { }
                if root.selected: Image {
                    source: @image-url("icons/check.svg");
                    width: 20px;
                    height: 20px;
                    colorize: root.colors[2];
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for c in root.colors: Rectangle {
                    width: 26px;
                    height: 8px;
                    border-radius: 4px;
                    background: c;
                }
            }
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.title;
                    color: #ffffff;
                    font-family: "Sora";
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: root.subtitle;
                    color: #ffffffb3;
                    font-family: "Inter";
                    font-size: 12px;
                    overflow: elide;
                }
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { Theme.style = root.style; }
    }
}

export component SettingsPage inherits Page {
    property <[color]> accents: [#2563EB, #7C3AED, #DB2777, #DC2626, #EA580C, #CA8A04, #16A34A, #0D9488, #0891B2, #52525B];

    SectionLabel { text: "DESIGN"; }
    HoloPanel {
        VerticalLayout {
            spacing: 12px;
            HudLabel { text: "STIL DER APP"; }
            HorizontalLayout {
                spacing: 12px;
                StyleCard {
                    style: 0;
                    title: "Holo";
                    subtitle: "Futuristisch, clean, leuchtend";
                    colors: [#0A0E1A, #7C5CFF, #22D3EE];
                    emoji: "✦";
                }
                StyleCard {
                    style: 1;
                    title: "Brainrot";
                    subtitle: "Laut, bunt, Meme-Style";
                    colors: [#14001F, #FF2E93, #B6FF00];
                    emoji: "💀";
                }
                StyleCard {
                    style: 2;
                    title: "Israel";
                    subtitle: "Shalom, Sababa, Yalla";
                    colors: [#06102E, #0038B8, #FFFFFF];
                    emoji: "🇮🇱";
                }
            }
            HorizontalLayout {
                spacing: 12px;
                StyleCard {
                    style: 3;
                    title: "Clean";
                    subtitle: "Ruhig, modern, eine Akzentfarbe";
                    colors: [#18181B, #2563EB, #E4E4E7];
                    emoji: "○";
                }
                StyleCard {
                    style: 4;
                    title: "Liquid Glass";
                    subtitle: "Glas, Licht und weiche Farben";
                    colors: [#1C2A4A, #0A84FF, #BF5AF2];
                    emoji: "◐";
                }
                Rectangle { }
            }
            if Theme.clean: VerticalLayout {
                spacing: 10px;
                HudLabel { text: "AKZENTFARBE"; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    for c in root.accents: Rectangle {
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: c;
                        border-width: Theme.accent-choice == c ? 3px : 0px;
                        border-color: Theme.text;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Theme.accent-choice = c; }
                        }
                    }
                }
            }
            Switch {
                text: "Dunkel";
                checked <=> Theme.dark;
            }
        }
    }

    SectionLabel { text: "KONTO"; }
    HoloPanel {
        VerticalLayout {
            spacing: 8px;
            Text {
                text: AppData.full-name;
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: AppData.school;
                color: Theme.muted;
                font-family: Theme.font-body;
                font-size: 13px;
                wrap: word-wrap;
            }
            HudLabel { text: AppData.fetched; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                OutlineButton {
                    text: "Neu laden";
                    clicked => { AppData.refresh(); }
                }
                OutlineButton {
                    text: "Abmelden";
                    clicked => { AppData.logout(); }
                }
            }
        }
    }

    SectionLabel { text: "ÜBER"; }
    HoloPanel {
        VerticalLayout {
            spacing: 4px;
            Text {
                text: "Register · Rust-Version";
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 15px;
                font-weight: 600;
            }
            Text {
                text: "Inoffizielle App für das Digitale Register. Die Daten bleiben auf deinem Gerät.";
                color: Theme.muted;
                font-family: Theme.font-body;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }
}
