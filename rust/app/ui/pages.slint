import { Theme } from "theme.slint";
import { AppData, Nav, HomeworkItem, Lesson, TestItem, TargetChip } from "data.slint";
import { GlowCard, HoloPanel, HudLabel, SectionLabel, StatusPill, HoloToggle, IconButton, TextButton, EmptyState, Field, PrimaryButton, NeonRing, Meter } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

// Scrollable content, centred and at most 860 px wide (readablePadding).
export component Page inherits ScrollView {
    VerticalLayout {
        padding-top: Theme.page-padding;
        padding-bottom: Theme.narrow ? 96px : 90px;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(Theme.max-content, root.visible-width - 2 * Theme.page-padding);
                spacing: 10px;
                @children
            }
        }
    }
}

// One row of the lesson list in the "now" card (_LessonLine).
component LessonLine inherits Rectangle {
    in property <Lesson> lesson;
    height: 32px;
    border-radius: 10px;
    background: lesson.is-now ? Theme.cyan.transparentize(86%) : transparent;
    border-width: lesson.is-now ? 1px : 0px;
    border-color: Theme.cyan.transparentize(40%);
    opacity: lesson.is-past ? 0.45 : 1.0;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            width: 36px;
            text: lesson.hours;
            color: Theme.text;
            font-family: Theme.font-mono;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            width: 92px;
            text: lesson.time;
            color: Theme.muted;
            font-family: Theme.font-mono;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            text: lesson.nick;
            color: lesson.is-now ? Theme.cyan : Theme.text;
            font-family: Theme.font-body;
            font-size: 14px;
            font-weight: lesson.is-now ? 700 : 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if lesson.has-test: Image {
            source: @image-url("icons/bolt.svg");
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.danger;
        }
        Text {
            text: lesson.rooms;
            color: Theme.text;
            font-family: Theme.font-mono;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

// The pill and bar of the absences (AbsenceMeter).
export component AbsenceMeter inherits VerticalLayout {
    property <color> tint: AppData.absence-level == 0 ? Theme.success : (AppData.absence-level == 1 ? Theme.warning : Theme.danger);
    spacing: 8px;
    HorizontalLayout {
        StatusPill {
            text: AppData.absence-level == 0 ? Theme.br("Im grünen Bereich", "Chillig 😎", "Sababa 😎")
                : (AppData.absence-level == 1 ? Theme.br("Aufpassen", "Sus 👀", "Achi, aufpassen 👀")
                : (AppData.absence-level == 2 ? Theme.br("Kritisch", "Gefährlich 💀", "Oy vey! Balagan 😱")
                : Theme.br("Über der Grenze", "Game over 💀", "Balagan total 😱")));
            tint: root.tint;
        }
        Rectangle { }
        HudLabel {
            text: AppData.absence-left;
            vertical-alignment: center;
        }
    }
    Meter {
        fraction: AppData.absence-fraction;
        tint: root.tint;
    }
}

// How many lessons may still be missed this school year (AbsenceYearOutlook).
export component AbsenceYearOutlook inherits VerticalLayout {
    property <color> tint: AppData.absence-level == 0 ? Theme.success : (AppData.absence-level == 1 ? Theme.warning : Theme.danger);
    spacing: 4px;
    HorizontalLayout {
        spacing: 8px;
        Image {
            source: @image-url("icons/event.svg");
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: root.tint;
        }
        Text {
            text: AppData.year-left == 0 ? Theme.br("Keine Fehlstunde mehr übrig", "0 Skips übrig 💀", "Keine Stunde mehr übrig 😱")
                : "Noch ~" + AppData.year-left + (AppData.year-left == 1 ? " Stunde" : " Stunden");
            color: root.tint;
            font-family: Theme.font-body;
            font-size: 13.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if AppData.year-left > 0: Text {
            text: AppData.year-allowed-rest;
            color: Theme.text;
            font-family: Theme.font-body;
            font-size: 13.5px;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
    Text {
        x: 24px;
        text: AppData.year-detail;
        color: Theme.muted;
        font-family: Theme.font-body;
        font-size: 11.5px;
    }
}

// A due entry (_TaskRow).
component TaskRow inherits HoloPanel {
    in property <HomeworkItem> item;
    has-accent: item.is-test || item.urgent;
    accent: item.is-test ? Theme.danger : Theme.warning;
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            HudLabel { text: item.header; }
            Text {
                text: item.title;
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 15.5px;
                font-weight: 600;
                wrap: word-wrap;
            }
            if item.subtitle != "": Text {
                text: item.subtitle;
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 12.5px;
                wrap: word-wrap;
                max-height: 36px;
                overflow: elide;
            }
        }
        if item.checked: Image {
            source: @image-url("icons/check_circle.svg");
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            colorize: Theme.success;
        }
    }
}

// "Ø6 → 7½" (_TargetChip).
component TargetPill inherits StatusPill {
    in property <TargetChip> chip;
    property <float> v: chip.needed-value;
    text: "Ø" + chip.target + " → " + (chip.kind == 0 ? Theme.br("sicher", "safe 🗿", "sababa 😎") : (chip.kind == 1 ? Theme.br("unmöglich", "L 💀", "oy vey 😵") : chip.needed));
    tint: chip.kind == 0 ? Theme.success : (chip.kind == 1 ? Theme.danger : (v < 6 ? Theme.danger : (v < 7 ? Theme.warning : (v < 8.5 ? Theme.violet : Theme.cyan))));
}

// A test with its countdown (_TestCountdown).
component TestCountdown inherits HoloPanel {
    in property <TestItem> test;
    property <color> tint: test.days <= 1 ? Theme.danger : (test.days <= 4 ? Theme.warning : Theme.cyan);
    has-accent: true;
    accent: root.tint;
    highlighted: test.days <= 1;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            width: 64px;
            alignment: center;
            Text {
                text: test.days <= 1 ? "!" : test.days;
                color: root.tint;
                font-family: Theme.font-mono;
                font-size: 28px;
                font-weight: 700;
                horizontal-alignment: center;
            }
            HudLabel {
                text: test.days == 0 ? "HEUTE" : (test.days == 1 ? "MORGEN" : "TAGE");
                color: root.tint;
                horizontal-alignment: center;
            }
        }
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            HudLabel { text: test.header; }
            Text {
                text: test.title;
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 15.5px;
                font-weight: 600;
                wrap: word-wrap;
            }
            if test.subtitle != "": Text {
                text: test.subtitle;
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 12.5px;
                wrap: word-wrap;
                max-height: 36px;
                overflow: elide;
            }
            if test.average-now != "": HorizontalLayout {
                padding-top: 4px;
                spacing: 6px;
                alignment: start;
                HudLabel {
                    text: "Ø JETZT " + test.average-now + " · BRAUCHST";
                    vertical-alignment: center;
                }
                for chip in test.targets: TargetPill { chip: chip; }
            }
        }
        if test.days >= 2: IconButton {
            y: (parent.height - self.height) / 2;
            icon: @image-url("icons/auto_awesome.svg");
            tint: Theme.violet;
            clicked => { Nav.study-plan = test.index; }
        }
    }
}

export component TodayPage inherits Page {
    property <string> headline: AppData.now-state == 0 ? "Stundenplan wird geladen"
        : (AppData.now-state == 1 ? Theme.br("Heute frei", "Heute frei, W 🏖️", "Heute frei – Sababa, ab zum Strand 🏖️")
        : (AppData.now-state == 2 ? AppData.now-subject
        : (AppData.now-state == 3 ? "Gleich: " + AppData.now-subject
        : (AppData.now-state == 4 ? Theme.br("Schulschluss", "Schulschluss 🗿", "Schulschluss – Yalla bye! 🏖️") : "Heute"))));
    property <string> detail: AppData.now-state == 0 ? "Sobald die Woche geladen ist, siehst du hier deine Stunden."
        : (AppData.now-state == 1 ? "Kein Unterricht eingetragen."
        : (AppData.now-state == 2 ? Theme.br("Läuft gerade", "Lock in 🔒", "Tachles, lock in 🔒") + " · noch " + AppData.now-minutes + " min" + (AppData.now-rooms == "" ? "" : " · " + AppData.now-rooms)
        : (AppData.now-state == 3 ? (AppData.now-minutes < 60 ? "Beginnt in " + AppData.now-minutes + " min" : "Beginnt um " + AppData.next-time)
        : (AppData.now-state == 4 ? Theme.br("Für heute geschafft.", "Sigma grindset ✔️ Für heute geschafft.", "Yalla bye! Ab an den Strand 🏖️") : ""))));
    property <int> meme: Math.mod(AppData.day-number, 16);

    GlowCard {
        VerticalLayout {
            spacing: 0px;
            HorizontalLayout {
                HudLabel {
                    text: AppData.now-header;
                    vertical-alignment: center;
                }
                Rectangle { }
                if AppData.now-state == 2: StatusPill { text: "Jetzt"; }
            }
            Rectangle { height: 8px; }
            HorizontalLayout {
                alignment: start;
                Text {
                    text: root.headline;
                    color: Theme.accent-gradient;
                    font-family: Theme.font-display;
                    font-size: 26px;
                    font-weight: Theme.display-weight;
                    letter-spacing: Theme.display-spacing;
                }
            }
            if root.detail != "": VerticalLayout {
                padding-top: 4px;
                Text {
                    text: root.detail;
                    color: Theme.text;
                    font-family: Theme.font-body;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }
            if AppData.today-lessons.length > 0: Rectangle { height: 16px; }
            for lesson in AppData.today-lessons: VerticalLayout {
                padding-bottom: 4px;
                LessonLine { lesson: lesson; }
            }
            HorizontalLayout {
                alignment: end;
                TextButton {
                    text: "Kalender";
                    icon: @image-url("icons/calendar_today.svg");
                    has-icon: true;
                    clicked => { Nav.page = 4; }
                }
            }
        }
    }

    // The israel look's meme of the day; a tap shows the next one.
    if Theme.israel: HoloPanel {
        clickable: true;
        clicked => { AppData.day-number += 1; }
        HorizontalLayout {
            spacing: 16px;
            Text {
                text: ["🥙", "🤯", "😎", "🍳", "🏖️", "👀", "🥜", "💙", "😵", "✌️", "🐪", "🎤", "☀️", "📚", "🧆", "🇮🇱"][root.meme];
                font-size: 44px;
                vertical-alignment: center;
            }
            VerticalLayout {
                spacing: 4px;
                alignment: center;
                HudLabel { text: "MEME DES TAGES · TIPPEN FÜR MEHR"; }
                Text {
                    text: ["Hummus > Mathe", "Yalla Balagan", "Sababa", "Shakshuka Time", "Matkot > Schule", "Ma nishma?", "Bamba-Pause", "Kapara alecha", "Oy vey", "Yalla bye", "Langsam, achi", "Eurovision-Energie", "Tel-Aviv-Mood", "Achi, lern mal", "Falafel-Logik", "Shalom, Test"][root.meme];
                    color: Theme.text;
                    font-family: Theme.font-display;
                    font-size: 21px;
                    font-weight: Theme.display-weight;
                }
                Text {
                    text: ["Wissenschaftlich bewiesen, achi.", "Mein Stundenplan, meine Hausaufgaben, mein Leben.", "Note 6. Reicht. Tachles.", "Erst frühstücken, dann lernen. Beseder?", "Pling. Plong. Pling. Plong.", "Ich nach dem Test, wenn jemand nach den Lösungen fragt.", "Wichtigster Teil des Schultags.", "An alle, die mir die Hausaufgaben schicken.", "Die Schularbeit ist morgen?!", "Letzte Stunde vorbei, ich bin weg.", "Kamel-Tempo am Montagmorgen.", "So laut feiere ich jede bestandene Prüfung.", "30 Grad im Kopf, 12 Grad im Klassenzimmer.", "– meine Eltern, jeden Tag.", "Je mehr Lernzettel, desto mehr Snacks.", "Wir sehen uns. Leider."][root.meme];
                    color: Theme.text;
                    font-family: Theme.font-body;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }
        }
    }

    if AppData.due.length > 0: SectionLabel { text: Theme.br("FÄLLIG", "FÄLLIG 😬", "FÄLLIG – YALLA YALLA ⏰"); }
    for item in AppData.due: TaskRow { item: item; }

    SectionLabel { text: Theme.br("TESTS & SCHULARBEITEN", "BOSS-FIGHTS ⚔️", "TESTS – YALLA BALAGAN 🤯"); }
    if AppData.tests.length == 0: HoloPanel {
        Text {
            text: "Keine Tests in den nächsten 30 Tagen eingetragen.";
            color: Theme.text;
            font-family: Theme.font-body;
            font-size: 14px;
            wrap: word-wrap;
        }
    }
    for test in AppData.tests: TestCountdown { test: test; }

    if AppData.weak.length > 0: SectionLabel { text: Theme.br("ACHTUNG BEI DEN NOTEN", "OHIO-ZONE 🌽", "OY VEY, BALAGAN BEI DEN NOTEN 😵"); }
    for subject in AppData.weak: HoloPanel {
        clickable: true;
        has-accent: true;
        accent: Theme.danger;
        clicked => { Nav.page = 2; }
        HorizontalLayout {
            spacing: 14px;
            NeonRing {
                size: 44px;
                value: subject.value;
                label: subject.label;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: subject.name;
                    color: Theme.text;
                    font-family: Theme.font-body;
                    font-size: 15.5px;
                    font-weight: 600;
                }
                Text {
                    text: "Unter 6 – unter Noten siehst du, was du im nächsten Test brauchst.";
                    color: Theme.text;
                    font-family: Theme.font-body;
                    font-size: 12.5px;
                    wrap: word-wrap;
                }
            }
            Image {
                source: @image-url("icons/chevron_right.svg");
                width: 24px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                colorize: Theme.text;
            }
        }
    }

    if AppData.absence-percent != "": SectionLabel { text: Theme.br("FEHLSTUNDEN", "SKIP-STATISTIK 🛌", "FEHLSTUNDEN 🏖️"); }
    if AppData.absence-percent != "": HoloPanel {
        clickable: true;
        clicked => { Nav.page = 3; }
        VerticalLayout {
            spacing: 10px;
            Text {
                text: AppData.absence-percent + " der Unterrichtszeit";
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 15.5px;
                font-weight: 600;
            }
            AbsenceMeter { }
            if AppData.year-detail != "": AbsenceYearOutlook { }
        }
    }
}

// Choosing the days of a study plan (_showStudyPlanDialog).
export component StudyPlanDialog inherits Rectangle {
    in property <TestItem> test;
    property <int> max-sessions: max(1, min(test.days, 5));
    in-out property <int> sessions: min(root.max-sessions, 3);
    property <[string]> days: AppData.study-days(test.index, root.sessions);
    background: #00000099;
    TouchArea {
        clicked => { Nav.study-plan = -1; }
    }
    GlowCard {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(440px, parent.width - 24px);
        TouchArea { }
        VerticalLayout {
            spacing: 12px;
            Text {
                text: "Lernplan erstellen";
                color: Theme.text;
                font-family: Theme.font-display;
                font-size: 20px;
                font-weight: Theme.display-weight;
            }
            Text {
                text: "Für „" + test.title + "“ am " + test.date-long + ". Die Lerntage werden als Erinnerungen im Register eingetragen.";
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 14px;
                wrap: word-wrap;
            }
            HudLabel { text: "LERNEINHEITEN"; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for n in root.max-sessions: Rectangle {
                    width: 36px;
                    height: 32px;
                    border-radius: 8px;
                    background: n + 1 == root.sessions ? Theme.violet : Theme.surface-high;
                    Text {
                        text: n + 1;
                        color: n + 1 == root.sessions ? #ffffff : Theme.text;
                        font-family: Theme.font-mono;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.sessions = n + 1; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for d in root.days: StatusPill {
                    text: d;
                    icon: @image-url("icons/menu_book.svg");
                    has-icon: true;
                    tint: Theme.violet;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                TextButton {
                    text: "Abbrechen";
                    clicked => { Nav.study-plan = -1; }
                }
                PrimaryButton {
                    width: 230px;
                    text: root.days.length + " Erinnerungen eintragen";
                    enabled: root.days.length > 0;
                    clicked => {
                        AppData.create-study-plan(test.index, root.sessions);
                        Nav.study-plan = -1;
                    }
                }
            }
        }
    }
}

// The check circle on the right of an entry (NeonCheck).
component NeonCheck inherits Rectangle {
    in property <bool> value;
    callback toggled();
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: value ? Theme.accent-gradient : transparent;
    border-width: value ? 0px : 1.6px;
    border-color: Theme.muted.transparentize(40%);
    if value: Image {
        source: @image-url("icons/check.svg");
        width: 16px;
        height: 16px;
        colorize: #ffffff;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

component HomeworkPanel inherits HoloPanel {
    in property <HomeworkItem> item;
    has-accent: item.is-test;
    accent: Theme.danger;
    inner-padding: 12px;
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            spacing: 5px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                Image {
                    width: 15px;
                    height: 15px;
                    y: (parent.height - self.height) / 2;
                    source: item.is-test ? @image-url("icons/bolt.svg") : (item.is-grade ? @image-url("icons/star.svg") : @image-url("icons/assignment.svg"));
                    colorize: item.is-test ? Theme.danger : Theme.cyan;
                }
                HudLabel {
                    text: item.header;
                    color: item.is-test ? Theme.danger : Theme.cyan;
                    vertical-alignment: center;
                }
                Rectangle { }
            }
            Text {
                text: item.title;
                color: item.checked ? Theme.muted : Theme.text;
                font-family: Theme.font-body;
                font-size: 16px;
                font-weight: 500;
                wrap: word-wrap;
            }
            if item.subtitle != "": Text {
                text: item.subtitle;
                color: Theme.muted;
                font-family: Theme.font-body;
                font-size: 14px;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            width: 28px;
            spacing: 6px;
            alignment: start;
            if item.deletable: IconButton {
                width: 28px;
                height: 28px;
                icon: @image-url("icons/delete_outline.svg");
                icon-size: 19px;
                clicked => { AppData.delete-reminder(item.id); }
            }
            if item.checkable: NeonCheck {
                value: item.checked;
                toggled => { AppData.toggle-done(item.id, item.kind, !item.checked); }
            }
        }
    }
}

export component HomeworkPage inherits Page {
    in-out property <int> adding: -1;

    HorizontalLayout {
        alignment: center;
        padding-bottom: 6px;
        HoloToggle {
            options: ["KOMMEND", "VERGANGEN"];
            selected: AppData.show-past ? 1 : 0;
            chosen(i) => { AppData.set-show-past(i == 1); }
        }
    }

    if AppData.homework.length == 0: EmptyState {
        icon: @image-url("icons/assignment.svg");
        title: "Nichts zu tun";
        text: "Keine Einträge im Register.";
    }

    for day[d] in AppData.homework: HorizontalLayout {
        spacing: 10px;
        // The timeline on the left.
        Rectangle {
            width: 22px;
            Rectangle {
                x: (parent.width - 2px) / 2;
                width: 2px;
                height: parent.height;
                background: Theme.violet.transparentize(65%);
            }
            Rectangle {
                y: 13px;
                x: (parent.width - self.width) / 2;
                width: day.is-today ? 14px : 10px;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.bg;
                border-width: 2px;
                border-color: day.is-today ? Theme.cyan : Theme.violet;
                Rectangle {
                    width: parent.width - 8px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: day.is-today ? Theme.cyan : Theme.violet;
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            padding-bottom: 8px;
            HorizontalLayout {
                VerticalLayout {
                    spacing: 0px;
                    HudLabel {
                        text: day.header;
                        color: day.is-today ? Theme.cyan : Theme.muted;
                    }
                    Text {
                        text: day.title;
                        color: Theme.text;
                        font-family: Theme.font-display;
                        font-size: 22px;
                        font-weight: 600;
                    }
                }
                Rectangle { }
                IconButton {
                    icon: @image-url("icons/add_circle_outline.svg");
                    tint: Theme.violet;
                    icon-size: 22px;
                    clicked => { root.adding = root.adding == d ? -1 : d; }
                }
            }
            if root.adding == d: HorizontalLayout {
                spacing: 8px;
                new-reminder := Field {
                    placeholder: "Neue Erinnerung, z. B. Vokabeln lernen";
                    accepted => {
                        if self.text != "" {
                            AppData.add-reminder(day.date, self.text);
                            root.adding = -1;
                        }
                    }
                }
                PrimaryButton {
                    width: 120px;
                    text: "Eintragen";
                    enabled: new-reminder.text != "";
                    clicked => {
                        AppData.add-reminder(day.date, new-reminder.text);
                        root.adding = -1;
                    }
                }
            }
            for item in day.items: HomeworkPanel { item: item; }
        }
    }
}
