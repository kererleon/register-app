import { Theme } from "theme.slint";
import { AppData, Nav, HomeworkItem, Lesson } from "data.slint";
import { GlowCard, HoloPanel, HudLabel, SectionLabel, StatusPill, HoloToggle, IconButton, TextButton, EmptyState, Field, PrimaryButton } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

// Scrollable content, centred and at most 860 px wide (readablePadding).
export component Page inherits ScrollView {
    VerticalLayout {
        padding-top: Theme.page-padding;
        padding-bottom: Theme.narrow ? 96px : 90px;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(Theme.max-content, root.visible-width - 2 * Theme.page-padding);
                spacing: 10px;
                @children
            }
        }
    }
}

// One row of the lesson list in the "now" card.
component LessonLine inherits Rectangle {
    in property <Lesson> lesson;
    height: 34px;
    border-radius: 8px;
    background: lesson.is-now ? Theme.cyan.transparentize(88%) : transparent;
    border-width: lesson.is-now ? 1px : 0px;
    border-color: Theme.cyan.transparentize(45%);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Text {
            width: 26px;
            text: lesson.hours;
            color: Theme.text;
            font-family: Theme.font-mono;
            font-size: 12.5px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            width: 98px;
            text: lesson.time;
            color: Theme.muted;
            font-family: Theme.font-mono;
            font-size: 12.5px;
            font-weight: 500;
            vertical-alignment: center;
        }
        Text {
            text: lesson.subject;
            color: lesson.is-now ? Theme.cyan : Theme.text;
            font-family: Theme.font-body;
            font-size: 14px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: lesson.rooms;
            color: Theme.text.transparentize(15%);
            font-family: Theme.font-mono;
            font-size: 11.5px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// A due entry or a test as a panel (today page).
component DuePanel inherits HoloPanel {
    in property <HomeworkItem> item;
    has-accent: item.is-test;
    accent: Theme.danger;
    inner-padding: 12px;
    VerticalLayout {
        spacing: 3px;
        HudLabel { text: item.header; }
        Text {
            text: item.title;
            color: Theme.text;
            font-family: Theme.font-body;
            font-size: 15.5px;
            font-weight: 500;
            wrap: word-wrap;
        }
        if item.subtitle != "": Text {
            text: item.subtitle;
            color: Theme.text.transparentize(10%);
            font-family: Theme.font-body;
            font-size: 12.5px;
            wrap: word-wrap;
        }
    }
}

export component TodayPage inherits Page {
    GlowCard {
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                HudLabel {
                    text: AppData.now-header;
                    vertical-alignment: center;
                }
                Rectangle { }
                if AppData.now-running: StatusPill { text: "Jetzt"; }
            }
            // As wide as the text, so the gradient runs over the word.
            HorizontalLayout {
                alignment: start;
                Text {
                    text: AppData.now-title;
                    color: Theme.accent-gradient;
                    font-family: Theme.font-display;
                    font-size: 26px;
                    font-weight: 700;
                }
            }
            if AppData.now-detail != "": Text {
                text: AppData.now-detail;
                color: Theme.text;
                font-family: Theme.font-body;
                font-size: 14px;
            }
            Rectangle { height: 8px; }
            for lesson in AppData.today-lessons: LessonLine { lesson: lesson; }
            HorizontalLayout {
                alignment: end;
                padding-top: 6px;
                TextButton {
                    text: "Kalender";
                    icon: @image-url("icons/calendar_today.svg");
                    has-icon: true;
                    clicked => { Nav.page = 4; }
                }
            }
        }
    }

    if AppData.due.length > 0: SectionLabel { text: "FÄLLIG"; }
    for item in AppData.due: DuePanel { item: item; }

    if AppData.tests.length > 0: SectionLabel { text: "TESTS & SCHULARBEITEN"; }
    for item in AppData.tests: DuePanel { item: item; }
}

// The check circle on the right of an entry (NeonCheck).
component NeonCheck inherits Rectangle {
    in property <bool> value;
    callback toggled();
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background: value ? Theme.accent-gradient : transparent;
    border-width: value ? 0px : 1.6px;
    border-color: Theme.muted.transparentize(40%);
    if value: Image {
        source: @image-url("icons/check.svg");
        width: 16px;
        height: 16px;
        colorize: #ffffff;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

component HomeworkPanel inherits HoloPanel {
    in property <HomeworkItem> item;
    has-accent: item.is-test;
    accent: Theme.danger;
    inner-padding: 12px;
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            spacing: 5px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                Image {
                    width: 15px;
                    height: 15px;
                    y: (parent.height - self.height) / 2;
                    source: item.is-test ? @image-url("icons/bolt.svg") : (item.is-grade ? @image-url("icons/star.svg") : @image-url("icons/assignment.svg"));
                    colorize: item.is-test ? Theme.danger : Theme.cyan;
                }
                HudLabel {
                    text: item.header;
                    color: item.is-test ? Theme.danger : Theme.cyan;
                    vertical-alignment: center;
                }
                Rectangle { }
            }
            Text {
                text: item.title;
                color: item.checked ? Theme.muted : Theme.text;
                font-family: Theme.font-body;
                font-size: 16px;
                font-weight: 500;
                wrap: word-wrap;
            }
            if item.subtitle != "": Text {
                text: item.subtitle;
                color: Theme.muted;
                font-family: Theme.font-body;
                font-size: 14px;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            width: 28px;
            spacing: 6px;
            alignment: start;
            if item.deletable: IconButton {
                width: 28px;
                height: 28px;
                icon: @image-url("icons/delete_outline.svg");
                icon-size: 19px;
                clicked => { AppData.delete-reminder(item.id); }
            }
            if item.checkable: NeonCheck {
                value: item.checked;
                toggled => { AppData.toggle-done(item.id, item.kind, !item.checked); }
            }
        }
    }
}

export component HomeworkPage inherits Page {
    in-out property <int> adding: -1;

    HorizontalLayout {
        alignment: center;
        padding-bottom: 6px;
        HoloToggle {
            options: ["KOMMEND", "VERGANGEN"];
            selected: AppData.show-past ? 1 : 0;
            chosen(i) => { AppData.set-show-past(i == 1); }
        }
    }

    if AppData.homework.length == 0: EmptyState {
        icon: @image-url("icons/assignment.svg");
        title: "Nichts zu tun";
        text: "Keine Einträge im Register.";
    }

    for day[d] in AppData.homework: HorizontalLayout {
        spacing: 10px;
        // The timeline on the left.
        Rectangle {
            width: 22px;
            Rectangle {
                x: (parent.width - 2px) / 2;
                width: 2px;
                height: parent.height;
                background: Theme.violet.transparentize(65%);
            }
            Rectangle {
                y: 13px;
                x: (parent.width - self.width) / 2;
                width: day.is-today ? 14px : 10px;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.bg;
                border-width: 2px;
                border-color: day.is-today ? Theme.cyan : Theme.violet;
                Rectangle {
                    width: parent.width - 8px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: day.is-today ? Theme.cyan : Theme.violet;
                }
            }
        }
        VerticalLayout {
            spacing: 8px;
            padding-bottom: 8px;
            HorizontalLayout {
                VerticalLayout {
                    spacing: 0px;
                    HudLabel {
                        text: day.header;
                        color: day.is-today ? Theme.cyan : Theme.muted;
                    }
                    Text {
                        text: day.title;
                        color: Theme.text;
                        font-family: Theme.font-display;
                        font-size: 22px;
                        font-weight: 600;
                    }
                }
                Rectangle { }
                IconButton {
                    icon: @image-url("icons/add_circle_outline.svg");
                    tint: Theme.violet;
                    icon-size: 22px;
                    clicked => { root.adding = root.adding == d ? -1 : d; }
                }
            }
            if root.adding == d: HorizontalLayout {
                spacing: 8px;
                new-reminder := Field {
                    placeholder: "Neue Erinnerung, z. B. Vokabeln lernen";
                    accepted => {
                        if self.text != "" {
                            AppData.add-reminder(day.date, self.text);
                            root.adding = -1;
                        }
                    }
                }
                PrimaryButton {
                    width: 120px;
                    text: "Eintragen";
                    enabled: new-reminder.text != "";
                    clicked => {
                        AppData.add-reminder(day.date, new-reminder.text);
                        root.adding = -1;
                    }
                }
            }
            for item in day.items: HomeworkPanel { item: item; }
        }
    }
}
