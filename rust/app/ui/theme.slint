// The look of the Flutter app's "Holo" style, with its exact colours, fonts
// and sizes (lib/ui/theme.dart and lib/ui/holo.dart). "Clean" is the light
// look with one accent colour.

import "fonts/inter-400.ttf";
import "fonts/inter-500.ttf";
import "fonts/inter-600.ttf";
import "fonts/inter-700.ttf";
import "fonts/sora-600.ttf";
import "fonts/sora-700.ttf";
import "fonts/jetbrains-mono-500.ttf";
import "fonts/jetbrains-mono-600.ttf";
import "fonts/jetbrains-mono-700.ttf";

export global Theme {
    in-out property <bool> dark: true;
    // Accent for the clean look.
    in-out property <color> accent-choice: #5b6cff;
    // True when the window is narrow (phone): bottom bar instead of the menu.
    in-out property <bool> narrow: false;

    // AppColors (holo)
    out property <color> violet: dark ? #7C5CFF : accent-choice;
    out property <color> violet-deep: dark ? #5B3DF5 : accent-choice.darker(25%);
    out property <color> cyan: dark ? #22D3EE : accent-choice;
    out property <color> success: dark ? #2DD4A3 : #22A06B;
    out property <color> warning: dark ? #F5B544 : #D99A1F;
    out property <color> danger: dark ? #FF5C7A : #E5484D;

    // ColorScheme
    out property <color> bg: dark ? #0A0E1A : #F4F6FB;            // surface / night
    out property <color> surface: dark ? #111729 : #FFFFFF;       // surfaceContainer
    out property <color> surface-high: dark ? #182038 : #EAEEF8;
    out property <color> drawer: dark ? #070A13 : #FFFFFF;        // surfaceContainerLowest
    out property <color> outline: dark ? #26304D : #D8DEEC;       // outlineVariant
    out property <color> text: dark ? #E7EAF6 : #0E1426;          // onSurface
    out property <color> muted: dark ? #98A2C3 : #59627E;         // onSurfaceVariant
    out property <color> selected-bg: dark ? #2A2163 : #E6E0FF;   // primaryContainer
    out property <color> primary: dark ? violet : violet-deep;
    out property <brush> accent-gradient: dark ? @linear-gradient(135deg, violet 0%, cyan 100%) : @linear-gradient(135deg, accent-choice 0%, accent-choice 100%);

    // Fonts: Inter for text, Sora for headings, JetBrains Mono for data.
    out property <string> font-body: "Inter";
    out property <string> font-display: "Sora";
    out property <string> font-mono: "JetBrains Mono";

    out property <length> radius-panel: 16px;
    out property <length> radius-card: 22px;
    out property <length> gap: 12px;
    out property <length> page-padding: narrow ? 12px : 16px;
    out property <length> max-content: 860px;
}
